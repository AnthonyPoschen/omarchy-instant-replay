#!/usr/bin/env bash
set -euo pipefail

PROGRAM="omarchy-instant-replay"
PROCESS_NAME="omarchy-instant-replay-gsr"
VERSION="0.1.0"

HOME="${HOME:?HOME is not set}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CONFIG_DIR="$CONFIG_HOME/omarchy-instant-replay"
STATE_DIR="$STATE_HOME/omarchy-instant-replay"
CONFIG_FILE="$CONFIG_DIR/config"
PID_FILE="$STATE_DIR/recorder.pid"
ACTIVITY_FILE="$STATE_DIR/activity"
LOG_FILE="$STATE_DIR/gsr.log"
SEGMENT_DIR="$STATE_DIR/segments"
SEGMENT_INDEX="$SEGMENT_DIR/index"
SAVE_JOBS_DIR="$STATE_DIR/save-jobs"

GSR_BIN="${SHADOWPLAY_GSR_BIN:-/usr/bin/gpu-screen-recorder}"
GSR_CLI_BIN="${SHADOWPLAY_GSR_CLI_BIN:-/usr/bin/gsr-cli}"
FFMPEG_BIN="${SHADOWPLAY_FFMPEG_BIN:-/usr/bin/ffmpeg}"
FOCUSED_MONITOR_BIN="${SHADOWPLAY_FOCUSED_MONITOR_BIN:-omarchy-hyprland-monitor-focused}"
HYPRCTL_BIN="${SHADOWPLAY_HYPRCTL_BIN:-/usr/bin/hyprctl}"
PYTHON_BIN="${SHADOWPLAY_PYTHON_BIN:-/usr/bin/python3}"
TIMEOUT_BIN="${SHADOWPLAY_TIMEOUT_BIN:-/usr/bin/timeout}"
HEAD_BIN="${SHADOWPLAY_HEAD_BIN:-/usr/bin/head}"

DEFAULT_SECONDS=60
DEFAULT_AUDIO="desktop"
DEFAULT_MODE="monitor"
DEFAULT_FILTER="all"
DEFAULT_CAPTURE_EXTENT="monitor"
# Filter=All still uses is_chrome_class even if the user empties this Denylist seed.
# org.quickshell is Omarchy 4's bar/menu/lock. The older names stay for leftover installs.
DEFAULT_BLACKLIST=$'org.quickshell\nwaybar\nwalker\nhyprlock'
DEFAULT_CODEC="auto"
DEFAULT_FPS=60
DEFAULT_QUALITY=40000
DEFAULT_CURSOR="true"
DEFAULT_FRAMERATE_MODE="cfr"
DEFAULT_BITRATE_MODE="cbr"
DEFAULT_CLIP_RESOLUTION="1080p"
DEFAULT_CLIP_SCALE="fit"
MIN_SECONDS=15
MAX_SECONDS=7200
MIN_FPS=1
MAX_FPS=240
MIN_QUALITY=1
MAX_QUALITY=200000
HYPR_JSON_MAX=1048576
NOTIFY_TITLE_MAX=80
NOTIFY_BODY_MAX=200
FFMPEG_TIMEOUT=180

CONFIG_MONITOR=""
CONFIG_SECONDS="$DEFAULT_SECONDS"
CONFIG_AUDIO="$DEFAULT_AUDIO"
CONFIG_MODE="$DEFAULT_MODE"
CONFIG_FILTER="$DEFAULT_FILTER"
CONFIG_CAPTURE_EXTENT="$DEFAULT_CAPTURE_EXTENT"
CONFIG_CODEC="$DEFAULT_CODEC"
CONFIG_FPS="$DEFAULT_FPS"
CONFIG_QUALITY="$DEFAULT_QUALITY"
CONFIG_CURSOR="$DEFAULT_CURSOR"
CONFIG_FRAMERATE_MODE="$DEFAULT_FRAMERATE_MODE"
CONFIG_BITRATE_MODE="$DEFAULT_BITRATE_MODE"
CONFIG_CLIP_RESOLUTION="$DEFAULT_CLIP_RESOLUTION"
CONFIG_CLIP_SCALE="$DEFAULT_CLIP_SCALE"
CONFIG_MATCH_LIST=""
CONFIG_BLACKLIST="$DEFAULT_BLACKLIST"
CONFIG_OUTPUT_DIR=""
CONFIG_REGION=""
CONFIG_PIN_ADDRESS=""

runtime_base() {
  local candidate="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
  if [[ -L $candidate ]]; then
    die "XDG_RUNTIME_DIR is a symbolic link: $candidate"
  fi
  if [[ -d $candidate && -w $candidate && -O $candidate ]]; then
    printf '%s\n' "$candidate"
    return
  fi
  die "XDG_RUNTIME_DIR is missing or not a writable directory owned by this user"
}

RUNTIME_BASE="$(runtime_base)"
RUNTIME_DIR="$RUNTIME_BASE/omarchy-instant-replay"
IPC="$RUNTIME_DIR/gsr.sock"
GSR_OUTPUT_DIR="$RUNTIME_DIR/gsr-output"
if [[ ! -e $CONFIG_FILE && -r $CONFIG_HOME/omarchy-shadowplay/config ]]; then
  mkdir -p "$CONFIG_DIR"
  cp -a "$CONFIG_HOME/omarchy-shadowplay/config" "$CONFIG_FILE"
fi
if [[ ! -e $ACTIVITY_FILE && -d $STATE_HOME/omarchy-shadowplay ]]; then
  mkdir -p "$STATE_DIR"
  cp -a "$STATE_HOME/omarchy-shadowplay/." "$STATE_DIR/"
fi
(umask 077; mkdir -p "$RUNTIME_DIR" "$STATE_DIR" "$CONFIG_DIR" "$SEGMENT_DIR" "$SAVE_JOBS_DIR" "$GSR_OUTPUT_DIR")
chmod 700 "$RUNTIME_DIR" "$STATE_DIR" "$CONFIG_DIR" "$SEGMENT_DIR" "$SAVE_JOBS_DIR" "$GSR_OUTPUT_DIR"

usage() {
  cat <<USAGE
Usage:
  $PROGRAM start
  $PROGRAM stop
  $PROGRAM save [seconds]
  $PROGRAM status [--json]
  $PROGRAM monitors [--json]
  $PROGRAM windows [--json]
  $PROGRAM settings show [--json]
  $PROGRAM settings set monitor <name|>
  $PROGRAM settings set seconds <15-7200>
  $PROGRAM settings set audio <none|desktop|both|window|window-mic>
  $PROGRAM settings set mode <monitor|follow|pin|region>
  $PROGRAM settings set filter <all|allowlist|denylist>
  $PROGRAM settings set matchList <class,regex,...>
  $PROGRAM settings set blacklist <csv>
  $PROGRAM settings set captureExtent <monitor|window>
  $PROGRAM settings set codec <name>
  $PROGRAM settings set fps <1-240>
  $PROGRAM settings set quality <integer>
  $PROGRAM settings set cursor <true|false>
  $PROGRAM settings set framerateMode <cfr|vfr>
  $PROGRAM settings set bitrateMode <cbr|vbr>
  $PROGRAM settings set clipResolution <720p|1080p|1440p|2160p>
  $PROGRAM settings set clipScale <fit|stretch|center>
  $PROGRAM settings set region <WxH+X+Y>
  $PROGRAM settings set pinAddress <hyprland-address>
  $PROGRAM pick-region
  $PROGRAM pick-window
  $PROGRAM pick-blacklist-window
  $PROGRAM pick-match-window
  $PROGRAM tick
  $PROGRAM doctor
  $PROGRAM --help
  $PROGRAM --version

Start a GPU Screen Recorder instant-replay buffer on one monitor, then save
the last N seconds without stopping the buffer.

An empty monitor setting captures whichever monitor is focused when start runs.
Changing the Buffer Target while Live flushes a Segment and restarts capture.
A Follow Subject change on the same monitor dumps the ring as a Segment and
clears it without stopping capture. Save joins overlapping Segments with the
live buffer into one Clip.

This process is launched as $PROCESS_NAME so Omarchy's stock screen recorder
does not treat it as a session recording. Only one KMS capture can run at a
time, so stock omarchy screenrecord may fail while the buffer is active.
USAGE
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit 1
}

die_usage() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  printf "Try '%s --help' for usage.\n" "$PROGRAM" >&2
  exit 2
}

json_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

json_string_or_null() {
  if [[ -n ${1:-} ]]; then
    json_string "$1"
  else
    printf 'null'
  fi
}

json_bool() {
  if [[ $1 == true ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

json_string_array() {
  local first="true" item
  printf '['
  if [[ -n ${1:-} ]]; then
    while IFS= read -r item; do
      [[ -n $item ]] || continue
      [[ $first == true ]] || printf ','
      first="false"
      json_string "$item"
    done <<<"$1"
  fi
  printf ']'
}

csv_to_lines() {
  local csv="${1:-}" item out=""
  [[ -n $csv ]] || return 0
  while IFS= read -r item; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [[ -n $item ]] || continue
    if [[ -n $out ]]; then
      out+=$'\n'
    fi
    out+="$item"
  done <<< "${csv//,/$'\n'}"
  printf '%s' "$out"
}

print_encoder_json() {
  printf '{'
  printf '"codec":%s,' "$(json_string "$CONFIG_CODEC")"
  printf '"fps":%s,' "$CONFIG_FPS"
  printf '"quality":%s,' "$CONFIG_QUALITY"
  printf '"cursor":%s,' "$(json_bool "$CONFIG_CURSOR")"
  printf '"framerateMode":%s,' "$(json_string "$CONFIG_FRAMERATE_MODE")"
  printf '"bitrateMode":%s' "$(json_string "$CONFIG_BITRATE_MODE")"
  printf '}'
}

normalize_clip_resolution() {
  case "${1:-}" in
  720p|1280x720) printf '720p' ;;
  1440p|2560x1440) printf '1440p' ;;
  2160p|4k|4K|3840x2160) printf '2160p' ;;
  1080p|1920x1080|"") printf '1080p' ;;
  *) printf '1080p' ;;
  esac
}

clip_resolution_size() {
  case "$(normalize_clip_resolution "${1:-$CONFIG_CLIP_RESOLUTION}")" in
  720p) printf '1280x720' ;;
  1440p) printf '2560x1440' ;;
  2160p) printf '3840x2160' ;;
  *) printf '1920x1080' ;;
  esac
}

normalize_clip_scale() {
  case "${1:-}" in
  stretch|distort|fill|cover|crop) printf 'stretch' ;;
  center|native) printf 'center' ;;
  fit|contain|"") printf 'fit' ;;
  *) printf 'fit' ;;
  esac
}

clip_layout_filter() {
  local cropf="${1:-}"
  local canvas="${2:-$(clip_resolution_size)}"
  local scale="${3:-$CONFIG_CLIP_SCALE}"
  local w=${canvas%%x*} h=${canvas#*x}
  local layout
  layout=$(normalize_clip_scale "$scale")
  case "$layout" in
  stretch)
    printf '%sscale=%s:%s,setsar=1,fps=60,format=yuv420p,setpts=PTS-STARTPTS' \
      "$cropf" "$w" "$h"
    ;;
  center)
    printf '%scrop=min(iw\\,%s):min(ih\\,%s):(iw-ow)/2:(ih-oh)/2,pad=%s:%s:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=60,format=yuv420p,setpts=PTS-STARTPTS' \
      "$cropf" "$w" "$h" "$w" "$h"
    ;;
  *)
    printf '%sscale=%s:%s:force_original_aspect_ratio=decrease,pad=%s:%s:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=60,format=yuv420p,setpts=PTS-STARTPTS' \
      "$cropf" "$w" "$h" "$w" "$h"
    ;;
  esac
}

print_settings_fields() {
  local extent="$CONFIG_CAPTURE_EXTENT"
  if [[ $CONFIG_MODE == pin ]]; then
    extent=window
  fi
  printf '"mode":%s,' "$(json_string "$CONFIG_MODE")"
  printf '"filter":%s,' "$(json_string "$CONFIG_FILTER")"
  printf '"captureExtent":%s,' "$(json_string "$extent")"
  printf '"clipResolution":%s,' "$(json_string "$CONFIG_CLIP_RESOLUTION")"
  printf '"clipScale":%s,' "$(json_string "$CONFIG_CLIP_SCALE")"
  printf '"matchList":%s,' "$(json_string_array "$CONFIG_MATCH_LIST")"
  printf '"blacklist":%s,' "$(json_string_array "$CONFIG_BLACKLIST")"
  printf '"pinAddress":%s,' "$(json_string "$CONFIG_PIN_ADDRESS")"
  printf '"encoder":%s' "$(print_encoder_json)"
}

reset_config_defaults() {
  BLACKLIST_PRESENT=false
  CONFIG_MONITOR=""
  CONFIG_SECONDS="$DEFAULT_SECONDS"
  CONFIG_AUDIO="$DEFAULT_AUDIO"
  CONFIG_MODE="$DEFAULT_MODE"
  CONFIG_FILTER="$DEFAULT_FILTER"
  CONFIG_CAPTURE_EXTENT="$DEFAULT_CAPTURE_EXTENT"
  CONFIG_CODEC="$DEFAULT_CODEC"
  CONFIG_FPS="$DEFAULT_FPS"
  CONFIG_QUALITY="$DEFAULT_QUALITY"
  CONFIG_CURSOR="$DEFAULT_CURSOR"
  CONFIG_FRAMERATE_MODE="$DEFAULT_FRAMERATE_MODE"
  CONFIG_BITRATE_MODE="$DEFAULT_BITRATE_MODE"
  CONFIG_CLIP_RESOLUTION="$DEFAULT_CLIP_RESOLUTION"
  CONFIG_CLIP_SCALE="$DEFAULT_CLIP_SCALE"
  CONFIG_MATCH_LIST=""
  CONFIG_BLACKLIST="$DEFAULT_BLACKLIST"
  CONFIG_OUTPUT_DIR=""
  CONFIG_REGION=""
  CONFIG_PIN_ADDRESS=""
}

config_value_safe() {
  [[ $1 != *$'\n'* && $1 != *$'\r'* ]]
}

now_epoch() {
  printf '%s\n' "${SHADOWPLAY_NOW:-$(date +%s)}"
}

sanitize_notify_text() {
  local s="$1" max="${2:-200}"
  s=${s//</}
  s=${s//>/}
  s=${s//&/}
  s=${s//$'\n'/ }
  s=${s//$'\r'/}
  if (( ${#s} > max )); then
    s=${s:0:max}
  fi
  printf '%s' "$s"
}

notify() {
  local title body
  title=$(sanitize_notify_text "$1" "$NOTIFY_TITLE_MAX")
  body=$(sanitize_notify_text "${2:-}" "$NOTIFY_BODY_MAX")
  [[ ${SHADOWPLAY_NOTIFY:-true} == true ]] || return 0
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    if [[ -n $body ]]; then
      omarchy-notification-send "$title" "$body" || true
    else
      omarchy-notification-send "$title" || true
    fi
    return
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$title" "$body" || true
  fi
}

load_config() {
  local key value
  local have_capture_extent=false
  reset_config_defaults

  [[ -r $CONFIG_FILE ]] || return 0
  while IFS='=' read -r key value || [[ -n ${key:-} ]]; do
    [[ -n ${key:-} && $key != \#* ]] || continue
    case "$key" in
    monitor) CONFIG_MONITOR="$value" ;;
    seconds)
      [[ $value =~ ^[0-9]+$ ]] && CONFIG_SECONDS="$value"
      ;;
    audio)
      [[ $value == none || $value == desktop || $value == both || $value == window || $value == window-mic ]] && CONFIG_AUDIO="$value"
      ;;
    mode)
      [[ $value == monitor || $value == follow || $value == pin || $value == region ]] && CONFIG_MODE="$value"
      ;;
    filter)
      [[ $value == all || $value == allowlist || $value == denylist ]] && CONFIG_FILTER="$value"
      ;;
    captureExtent)
      if [[ $value == monitor || $value == window ]]; then
        CONFIG_CAPTURE_EXTENT="$value"
        have_capture_extent=true
      fi
      ;;
    codec)
      if config_value_safe "$value" && [[ -n $value ]]; then
        CONFIG_CODEC=$(normalize_codec "$value")
      fi
      ;;
    fps)
      [[ $value =~ ^[0-9]+$ ]] && CONFIG_FPS="$value"
      ;;
    quality)
      [[ $value =~ ^[0-9]+$ ]] && CONFIG_QUALITY="$value"
      ;;
    cursor)
      [[ $value == true || $value == false ]] && CONFIG_CURSOR="$value"
      ;;
    framerateMode)
      [[ $value == cfr || $value == vfr ]] && CONFIG_FRAMERATE_MODE="$value"
      ;;
    bitrateMode)
      [[ $value == cbr || $value == vbr ]] && CONFIG_BITRATE_MODE="$value"
      ;;
    clipResolution)
      CONFIG_CLIP_RESOLUTION="$(normalize_clip_resolution "$value")"
      ;;
    clipScale)
      CONFIG_CLIP_SCALE="$(normalize_clip_scale "$value")"
      ;;
    matchList)
      CONFIG_MATCH_LIST="$(csv_to_lines "$value")"
      ;;
    blacklist)
      CONFIG_BLACKLIST="${value//,/
}"
      BLACKLIST_PRESENT=true
      ;;
    outputDir)
      config_value_safe "$value" && CONFIG_OUTPUT_DIR="$value"
      ;;
    region)
      config_value_safe "$value" && CONFIG_REGION="$value"
      ;;
    pinAddress)
      config_value_safe "$value" && CONFIG_PIN_ADDRESS="$value"
      ;;
    esac
  done < "$CONFIG_FILE"
  if [[ ${BLACKLIST_PRESENT:-false} != true ]]; then
    CONFIG_BLACKLIST="$DEFAULT_BLACKLIST"
  fi
  if [[ $CONFIG_MODE == follow || $CONFIG_MODE == pin ]]; then
    CONFIG_CAPTURE_EXTENT=window
  fi
  clamp_seconds
  clamp_fps
  clamp_quality
  if [[ $CONFIG_MODE == pin ]]; then
    CONFIG_CAPTURE_EXTENT=window
  fi
}

clamp_seconds() {
  if (( CONFIG_SECONDS < MIN_SECONDS )); then
    CONFIG_SECONDS=$MIN_SECONDS
  elif (( CONFIG_SECONDS > MAX_SECONDS )); then
    CONFIG_SECONDS=$MAX_SECONDS
  fi
}

clamp_fps() {
  if (( CONFIG_FPS < MIN_FPS )); then
    CONFIG_FPS=$MIN_FPS
  elif (( CONFIG_FPS > MAX_FPS )); then
    CONFIG_FPS=$MAX_FPS
  fi
}

clamp_quality() {
  if ! [[ $CONFIG_QUALITY =~ ^[0-9]+$ ]]; then
    CONFIG_QUALITY=$DEFAULT_QUALITY
    return
  fi
  if (( CONFIG_QUALITY < MIN_QUALITY )); then
    CONFIG_QUALITY=$MIN_QUALITY
  elif (( CONFIG_QUALITY > MAX_QUALITY )); then
    CONFIG_QUALITY=$MAX_QUALITY
  fi
}

normalize_codec() {
  case "${1:-}" in
  auto|h264|hevc|av1|vp8|vp9) printf '%s' "$1" ;;
  *) printf '%s' "$DEFAULT_CODEC" ;;
  esac
}

write_config() {
  config_value_safe "$CONFIG_MONITOR" || die "monitor value contains a newline"
  config_value_safe "$CONFIG_CODEC" || die "codec value contains a newline"
  config_value_safe "$CONFIG_OUTPUT_DIR" || die "outputDir value contains a newline"
  config_value_safe "$CONFIG_REGION" || die "region value contains a newline"
  config_value_safe "$CONFIG_PIN_ADDRESS" || die "pinAddress value contains a newline"
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR" 2>/dev/null || true
  local tmp
  tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX")
  local match_csv blacklist_csv
  match_csv=${CONFIG_MATCH_LIST//$'\n'/,}
  blacklist_csv=${CONFIG_BLACKLIST//$'\n'/,}
  (umask 077
    {
      printf '# omarchy-instant-replay configuration v1\n'
      printf 'monitor=%s\n' "$CONFIG_MONITOR"
      printf 'seconds=%s\n' "$CONFIG_SECONDS"
      printf 'audio=%s\n' "$CONFIG_AUDIO"
      printf 'mode=%s\n' "$CONFIG_MODE"
      printf 'filter=%s\n' "$CONFIG_FILTER"
      printf 'captureExtent=%s\n' "$CONFIG_CAPTURE_EXTENT"
      printf 'codec=%s\n' "$CONFIG_CODEC"
      printf 'fps=%s\n' "$CONFIG_FPS"
      printf 'quality=%s\n' "$CONFIG_QUALITY"
      printf 'cursor=%s\n' "$CONFIG_CURSOR"
      printf 'framerateMode=%s\n' "$CONFIG_FRAMERATE_MODE"
      printf 'bitrateMode=%s\n' "$CONFIG_BITRATE_MODE"
      printf 'clipResolution=%s\n' "$CONFIG_CLIP_RESOLUTION"
      printf 'clipScale=%s\n' "$CONFIG_CLIP_SCALE"
      printf 'matchList=%s\n' "$match_csv"
      printf 'blacklist=%s\n' "$blacklist_csv"
      printf 'outputDir=%s\n' "$CONFIG_OUTPUT_DIR"
      printf 'region=%s\n' "$CONFIG_REGION"
      printf 'pinAddress=%s\n' "$CONFIG_PIN_ADDRESS"
    } > "$tmp"
  )
  mv -f "$tmp" "$CONFIG_FILE"
}

expand_user_path() {
  local dir="$1"
  if [[ $dir == "~" ]]; then
    printf '%s\n' "$HOME"
  elif [[ $dir == "~/"* ]]; then
    printf '%s\n' "$HOME/${dir#~/}"
  else
    printf '%s\n' "$dir"
  fi
}

xdg_videos_from_user_dirs() {
  local file="$HOME/.config/user-dirs.dirs"
  [[ -e $file && ! -L $file && -f $file ]] || return 1
  local line value
  while IFS= read -r line || [[ -n ${line:-} ]]; do
    [[ $line == XDG_VIDEOS_DIR=* ]] || continue
    value=${line#XDG_VIDEOS_DIR=}
    value=${value#\"}
    value=${value%\"}
    value=${value//\$HOME/$HOME}
    [[ $value == /* && $value != *$'\n'* ]] || return 1
    printf '%s\n' "$value"
    return 0
  done < "$file"
  return 1
}

output_dir() {
  local dir="${SHADOWPLAY_OUTPUT_DIR:-}"
  if [[ -z $dir && -n $CONFIG_OUTPUT_DIR ]]; then
    dir=$(expand_user_path "$CONFIG_OUTPUT_DIR")
  fi
  if [[ -z $dir ]]; then
    if [[ -n ${OMARCHY_SCREENRECORD_DIR:-} ]]; then
      dir="$OMARCHY_SCREENRECORD_DIR/Replays"
    elif [[ -n ${XDG_VIDEOS_DIR:-} ]]; then
      dir="$XDG_VIDEOS_DIR/Replays"
    elif videos=$(xdg_videos_from_user_dirs); then
      dir="$videos/Replays"
    else
      dir="$HOME/Videos/Replays"
    fi
  fi
  printf '%s\n' "$dir"
}

pid_alive() {
  local pid="$1"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

pid_cmdline() {
  local pid="$1"
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true
}

pid_is_ours() {
  local pid="$1" comm
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  pid_alive "$pid" || return 1
  comm=$(pid_cmdline "$pid")
  [[ $comm == *omarchy-instant-replay-gsr* || $comm == *omarchy-shadowplay-gsr* || $comm == *fake-gsr* ]] || return 1
}

read_pid() {
  local pid=""
  [[ -r $PID_FILE ]] || return 1
  pid=$(<"$PID_FILE")
  pid_is_ours "$pid" || return 1
  printf '%s\n' "$pid"
}

write_pid_file() {
  local pid="$1" tmp
  tmp=$(mktemp "$STATE_DIR/.pid.XXXXXX")
  printf '%s\n' "$pid" > "$tmp"
  mv -f "$tmp" "$PID_FILE"
}

acquire_state_lock() {
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  local lock="$STATE_DIR/state.lock"
  if [[ -L $lock ]]; then
    die "state lock is a symbolic link"
  fi
  exec {STATE_LOCK_FD}>>"$lock"
  flock "$STATE_LOCK_FD"
}

cli_running() {
  "$GSR_CLI_BIN" -ipc "$IPC" status >/dev/null 2>&1
}

buffer_running() {
  local pid=""
  pid=$(read_pid 2>/dev/null || true)
  if [[ -n $pid ]] && cli_running; then
    return 0
  fi
  if [[ -n $pid ]] && ! cli_running; then
    return 1
  fi
  cli_running
}

# Stock Omarchy screenrecord matches argv0 gpu-screen-recorder. Never signal those PIDs.
session_recording_pids() {
  local fake="${SHADOWPLAY_FAKE_DIR:-}"
  if [[ -n $fake ]]; then
    if [[ -r $fake/session-recording ]]; then
      cat "$fake/session-recording"
    fi
    return 0
  fi
  pgrep -f '^gpu-screen-recorder' 2>/dev/null || true
}

capture_device_busy() {
  local pids
  pids=$(session_recording_pids)
  [[ -n $pids ]]
}

die_device_busy() {
  local extra="${1:-}"
  local message="capture device is busy: a Session Recording is running"
  if [[ -n $extra ]]; then
    die "$message"$'\n'"$extra"
  fi
  die "$message"
}

list_monitor_lines() {
  "$GSR_BIN" --list-monitors 2>/dev/null || true
}

list_monitor_names() {
  list_monitor_lines | awk -F'|' 'NF { print $1 }'
}

normalize_region_spec() {
  local spec="$1"
  spec=${spec//$'\n'/}
  if [[ $spec =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]+([0-9]+)x([0-9]+)$ ]]; then
    printf '%sx%s+%s+%s\n' "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    return 0
  fi
  if [[ $spec =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]]; then
    printf '%s\n' "$spec"
    return 0
  fi
  return 1
}

parse_region_spec() {
  local spec
  spec=$(normalize_region_spec "$1") || return 1
  [[ $spec =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
  REGION_W="${BASH_REMATCH[1]}"
  REGION_H="${BASH_REMATCH[2]}"
  REGION_X="${BASH_REMATCH[3]}"
  REGION_Y="${BASH_REMATCH[4]}"
}

list_monitor_geometry_lines() {
  local line name size rest origin w h x y
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    name=${line%%|*}
    rest=${line#*|}
    size=${rest%%|*}
    origin=""
    if [[ $rest == *'|'* ]]; then
      origin=${rest#*|}
    fi
    w=${size%%x*}
    h=${size#*x}
    x=""
    y=""
    if [[ $origin =~ ^(-?[0-9]+)[,x](-?[0-9]+)$ ]]; then
      x="${BASH_REMATCH[1]}"
      y="${BASH_REMATCH[2]}"
    fi
    printf '%s|%s|%s|%s|%s\n' "$name" "$w" "$h" "$x" "$y"
  done < <(list_monitor_lines)
}

hypr_monitor_geometry_lines() {
  local bin="${SHADOWPLAY_HYPRCTL_BIN:-hyprctl}"
  command -v "$bin" >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  "$bin" monitors -j 2>/dev/null | jq -r '
    .[]? |
    select(.name != null and .width != null and .height != null and .x != null and .y != null) |
    "\(.name)|\((.width / (.scale // 1)) | floor)|\((.height / (.scale // 1)) | floor)|\(.x)|\(.y)"
  ' || true
}

monitor_geometry_lines() {
  local lines
  lines=$(list_monitor_geometry_lines)
  local complete="true" name w h x y
  while IFS='|' read -r name w h x y; do
    [[ -n $name ]] || continue
    if [[ -z $x || -z $y ]]; then complete="false"; break; fi
  done <<<"$lines"
  if [[ $complete == true && -n $lines ]]; then
    printf '%s\n' "$lines"
    return
  fi
  local hypr
  hypr=$(hypr_monitor_geometry_lines)
  if [[ -n $hypr ]]; then
    printf '%s\n' "$hypr"
    return
  fi
  printf '%s\n' "$lines"
}

region_host_monitor() {
  local spec="$1"
  parse_region_spec "$spec" || die "region must be WxH+X+Y"
  (( REGION_W > 0 && REGION_H > 0 )) || die "region width and height must be positive"
  local name w h x y rx ry rw rh right bottom mx my
  rx=$REGION_X; ry=$REGION_Y; rw=$REGION_W; rh=$REGION_H
  right=$((rx + rw))
  bottom=$((ry + rh))
  local host="" overlap_count=0
  while IFS='|' read -r name w h x y; do
    [[ -n $name && $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ && $x =~ ^-?[0-9]+$ && $y =~ ^-?[0-9]+$ ]] || continue
    mx=$((x + w))
    my=$((y + h))
    if (( rx >= x && ry >= y && right <= mx && bottom <= my )); then
      host="$name"
      overlap_count=$((overlap_count + 1))
    elif (( rx < mx && right > x && ry < my && bottom > y )); then
      overlap_count=$((overlap_count + 1))
    fi
  done < <(monitor_geometry_lines)
  if (( overlap_count > 1 )); then
    die "region spans more than one monitor"
  fi
  [[ -n $host ]] || die "region does not sit on a capture monitor"
  printf '%s\n' "$host"
}

validate_region() {
  local spec="$1"
  region_host_monitor "$spec" >/dev/null
}

pick_region_spec() {
  local bin="${SHADOWPLAY_REGION_PICKER:-omarchy-capture-region}"
  command -v "$bin" >/dev/null 2>&1 || die "region picker is not available: $bin"
  local spec
  spec=$("$bin") || die "region picker was cancelled"
  spec=$(normalize_region_spec "$spec") || die "region picker returned an invalid rectangle"
  [[ -n $spec ]] || die "region picker was cancelled"
  printf '%s\n' "$spec"
}

pick_window_from_menu() {
  command -v omarchy-menu-select >/dev/null 2>&1 || die "window picker is not available: omarchy-menu-select"
  local line class mon addr rows="" label selection
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r class _ mon addr _ <<<"$line"
    [[ -n $addr ]] || continue
    label="$class"
    [[ -n $mon ]] && label="$class · $mon"
    rows+="󰖯"$'\t'"$label"$'\t'"$addr"$'\n'
  done < <(parse_windows)
  [[ -n $rows ]] || die "no windows to pin"
  selection=$(omarchy-menu-select "Pin window" <<<"$rows") || die "window picker was cancelled"
  addr=$(cut -f2 <<<"$selection")
  addr=${addr//[[:space:]]/}
  [[ -n $addr ]] || die "window picker was cancelled"
  printf '%s\n' "$addr"
}

pick_window_from_click() {
  local slurp="${SHADOWPLAY_SLURP_BIN:-slurp}"
  command -v "$slurp" >/dev/null 2>&1 || return 1
  local line klass addr atx aty ww hh boxes="" spec rx ry rw rh cx cy
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass _ _ addr _ _ atx aty ww hh _ <<<"$line"
    [[ -n $addr && $atx =~ ^-?[0-9]+$ && $aty =~ ^-?[0-9]+$ && $ww =~ ^[0-9]+$ && $hh =~ ^[0-9]+$ ]] || continue
    (( ww > 0 && hh > 0 )) || continue
    boxes+="${atx},${aty} ${ww}x${hh}"$'\n'
  done < <(parse_windows)
  [[ -n $boxes ]] || die "no windows to pick"
  spec=$("$slurp" -r <<<"$boxes") || die "window picker was cancelled"
  spec=$(normalize_region_spec "$spec") || die "window picker returned an invalid rectangle"
  parse_region_spec "$spec" || die "window picker returned an invalid rectangle"
  rx=$REGION_X; ry=$REGION_Y; rw=$REGION_W; rh=$REGION_H
  cx=$((rx + rw / 2))
  cy=$((ry + rh / 2))
  local best="" best_area=0 area
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass _ _ addr _ _ atx aty ww hh _ <<<"$line"
    [[ -n $addr && $atx =~ ^-?[0-9]+$ && $aty =~ ^-?[0-9]+$ && $ww =~ ^[0-9]+$ && $hh =~ ^[0-9]+$ ]] || continue
    if (( rx == atx && ry == aty && rw == ww && rh == hh )); then
      printf '%s\n' "$addr"
      return 0
    fi
    if (( cx >= atx && cy >= aty && cx < atx + ww && cy < aty + hh )); then
      area=$((ww * hh))
      if [[ -z $best ]] || (( area < best_area )); then
        best=$addr
        best_area=$area
      fi
    fi
  done < <(parse_windows)
  [[ -n $best ]] || die "window picker did not hit a window"
  printf '%s\n' "$best"
}

pick_window_address() {
  local bin="${SHADOWPLAY_WINDOW_PICKER:-}" out addr
  if [[ -n $bin ]]; then
    command -v "$bin" >/dev/null 2>&1 || die "window picker is not available: $bin"
    out=$("$bin") || die "window picker was cancelled"
    out=${out//$'\n'/}
    addr=${out%%|*}
    addr=${addr//[[:space:]]/}
    [[ -n $addr ]] || die "window picker was cancelled"
    printf '%s\n' "$addr"
    return
  fi
  pick_window_from_click && return
  pick_window_from_menu
}

append_blacklist_class() {
  local class="$1" line
  [[ -n $class ]] || return 1
  while IFS= read -r line; do
    [[ $line == "$class" ]] && return 0
  done <<<"$CONFIG_BLACKLIST"
  if [[ -n $CONFIG_BLACKLIST ]]; then
    CONFIG_BLACKLIST+=$'\n'"$class"
  else
    CONFIG_BLACKLIST="$class"
  fi
}

append_match_list_class() {
  local class="$1" line
  [[ -n $class ]] || return 1
  while IFS= read -r line; do
    [[ $line == "$class" ]] && return 0
  done <<<"$CONFIG_MATCH_LIST"
  if [[ -n $CONFIG_MATCH_LIST ]]; then
    CONFIG_MATCH_LIST+=$'\n'"$class"
  else
    CONFIG_MATCH_LIST="$class"
  fi
}

focused_monitor() {
  if [[ -n ${SHADOWPLAY_FOCUSED_MONITOR:-} ]]; then
    printf '%s\n' "$SHADOWPLAY_FOCUSED_MONITOR"
    return
  fi
  if command -v "$FOCUSED_MONITOR_BIN" >/dev/null 2>&1; then
    "$FOCUSED_MONITOR_BIN"
    return
  fi
  list_monitor_names | head -n 1
}

resolve_monitor() {
  local requested="$CONFIG_MONITOR"
  local names name found="false"
  names=$(list_monitor_names)
  [[ -n $names ]] || die "no capture monitors were reported by $GSR_BIN"
  if [[ -z $requested ]]; then
    requested=$(focused_monitor)
    [[ -n $requested ]] || die "could not determine the focused monitor"
  fi
  while IFS= read -r name; do
    if [[ $name == "$requested" ]]; then
      found="true"
      break
    fi
  done <<<"$names"
  [[ $found == true ]] || die "monitor is not available: $requested"
  printf '%s\n' "$requested"
}

activity_value() {
  local key="$1"
  local found=""
  [[ -r $ACTIVITY_FILE ]] || return 0
  found=$(awk -F= -v k="$key" '$1==k { print substr($0, index($0, "=")+1); exit }' "$ACTIVITY_FILE")
  printf '%s' "$found"
}

write_activity() {
  local running="$1" monitor="$2" seconds="$3" audio="$4" last_clip="${5:-}" started="${6:-}"
  local phase="${7:-}"
  local subject_class="${8:-}"
  local subject_address="${9:-}"
  local linger_until="${10:-}"
  local crop="${11:-}"
  local tmp
  tmp=$(mktemp "$STATE_DIR/.activity.XXXXXX")
  if [[ -z $phase ]]; then
    phase=$(activity_value phase)
  fi
  if [[ -z $phase ]]; then
    if [[ $running == true ]]; then
      phase=live
    else
      phase=off
    fi
  fi
  if [[ $running == true && -z $started ]]; then
    started=$(activity_value started)
    [[ -n $started ]] || started=$(now_epoch)
  fi
  if [[ -z $subject_class ]]; then
    subject_class=$(activity_value subject_class)
  elif [[ $subject_class == "-" ]]; then
    subject_class=""
  fi
  if [[ -z $subject_address ]]; then
    subject_address=$(activity_value subject_address)
  elif [[ $subject_address == "-" ]]; then
    subject_address=""
  fi
  if [[ -z $linger_until ]]; then
    linger_until=$(activity_value linger_until)
  elif [[ $linger_until == "-" ]]; then
    linger_until=""
  fi
  if [[ -z $crop ]]; then
    crop=$(activity_value crop)
  elif [[ $crop == "-" ]]; then
    crop="full"
  fi
  [[ -n $crop ]] || crop=full
  (umask 077
    {
      printf 'running=%s\n' "$running"
      printf 'monitor=%s\n' "$monitor"
      printf 'seconds=%s\n' "$seconds"
      printf 'audio=%s\n' "$audio"
      if [[ ${AUDIO_APP_SET:-} == 1 ]]; then
        printf 'audio_app=%s\n' "$AUDIO_APP"
      else
        printf 'audio_app=%s\n' "$(activity_value audio_app)"
      fi
      printf 'last_clip=%s\n' "$last_clip"
      printf 'started=%s\n' "$started"
      printf 'codec=%s\n' "$CONFIG_CODEC"
      printf 'fps=%s\n' "$CONFIG_FPS"
      printf 'quality=%s\n' "$CONFIG_QUALITY"
      printf 'cursor=%s\n' "$CONFIG_CURSOR"
      printf 'framerate_mode=%s\n' "$CONFIG_FRAMERATE_MODE"
      printf 'bitrate_mode=%s\n' "$CONFIG_BITRATE_MODE"
      printf 'mode=%s\n' "$CONFIG_MODE"
      printf 'capture_extent=%s\n' "$CONFIG_CAPTURE_EXTENT"
      printf 'phase=%s\n' "$phase"
      printf 'subject_class=%s\n' "$subject_class"
      printf 'subject_address=%s\n' "$subject_address"
      printf 'linger_until=%s\n' "$linger_until"
      printf 'crop=%s\n' "$crop"
      printf 'region=%s\n' "$CONFIG_REGION"
      printf 'pinAddress=%s\n' "$CONFIG_PIN_ADDRESS"
    } > "$tmp"
  )
  mv -f "$tmp" "$ACTIVITY_FILE"
}

wait_until_running() {
  local pid="$1"
  local i
  for ((i = 0; i < 50; i++)); do
    if ! pid_alive "$pid"; then
      return 1
    fi
    if cli_running; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_until_stopped() {
  local pid="${1:-}"
  local i
  for ((i = 0; i < 50; i++)); do
    if [[ -n $pid ]] && pid_alive "$pid"; then
      sleep 0.1
      continue
    fi
    if cli_running; then
      sleep 0.1
      continue
    fi
    return 0
  done
  return 1
}

apply_start_flags() {
  local arg
  for arg in "$@"; do
    case "$arg" in
    --monitor=*) CONFIG_MONITOR="${arg#--monitor=}" ;;
    --seconds=*)
      local value="${arg#--seconds=}"
      [[ $value =~ ^[0-9]+$ ]] || die "seconds must be an integer"
      CONFIG_SECONDS="$value"
      clamp_seconds
      [[ $CONFIG_SECONDS == "$value" ]] || die "seconds must be between $MIN_SECONDS and $MAX_SECONDS"
      ;;
    --audio=*)
      local value="${arg#--audio=}"
      [[ $value == none || $value == desktop || $value == both || $value == window || $value == window-mic ]] || die "audio must be none, desktop, both, window, or window-mic"
      CONFIG_AUDIO="$value"
      ;;
    --region=*)
      local value="${arg#--region=}"
      value=$(normalize_region_spec "$value") || die "region must be WxH+X+Y or X,Y WxH"
      CONFIG_REGION="$value"
      ;;
    --pin=*)
      CONFIG_PIN_ADDRESS="${arg#--pin=}"
      ;;
    --mode=*)
      local value="${arg#--mode=}"
      [[ $value == monitor || $value == follow || $value == pin || $value == region ]] || die "mode must be monitor, follow, pin, or region"
      CONFIG_MODE="$value"
      ;;
    "") ;;
    *) die_usage "unknown start option: $arg" ;;
    esac
  done
}

log_looks_busy() {
  local log="$1"
  grep -qiE 'busy|kms.*(in use|busy)|device.*(busy|in use)|already.*(captur|record)' <<<"$log"
}

save_replay_path() {
  local seconds="${1:-}"
  local restart="${2:-}"
  local path=""
  local -a args=(-ipc "$IPC" save-replay)
  mkdir -p "$STATE_DIR"
  if [[ -L $STATE_DIR/replay.lock ]]; then
    die "replay lock is a symbolic link"
  fi
  exec 8>>"$STATE_DIR/replay.lock"
  flock 8
  if [[ -n $seconds ]]; then
    args+=("$seconds")
  fi
  if [[ $restart == restart ]]; then
    args+=(restart-replay=true)
  fi
  path=$("$GSR_CLI_BIN" "${args[@]}") || return 1
  path=${path//$'\n'/}
  [[ -n $path ]] || return 1
  printf '%s\n' "$path"
}

write_segment_index() {
  local tmp
  tmp=$(mktemp "$SEGMENT_DIR/.index.XXXXXX")
  (umask 077
    cat > "$tmp"
  )
  mv -f "$tmp" "$SEGMENT_INDEX"
}

discard_all_segments() {
  rm -f "$SEGMENT_INDEX"
  find "$SEGMENT_DIR" -mindepth 1 -maxdepth 1 ! -name index -delete 2>/dev/null || true
}

consume_segment_job() {
  local index="$1"
  local end path
  [[ -n $index && -r $index ]] || return 0
  while IFS='|' read -r end path _ || [[ -n ${end:-} ]]; do
    [[ -n ${path:-} ]] || continue
    rm -f "$path"
  done < "$index"
  rm -f "$index"
}

clip_path_claimed() {
  local path="$1" dest
  [[ -e $path || -e $path.pending ]] && return 0
  (
    shopt -s nullglob
    for dest in "$SAVE_JOBS_DIR"/*/dest; do
      [[ -r $dest ]] || continue
      [[ $(<"$dest") == "$path" ]] && exit 0
    done
    exit 1
  )
}

unique_clip_path() {
  local dir="$1" stamp="$2"
  local path n
  path="$dir/Replay-${stamp}.mp4"
  n=2
  while clip_path_claimed "$path"; do
    path="$dir/Replay-${stamp}-$n.mp4"
    n=$((n + 1))
  done
  printf '%s\n' "$path"
}

job_pid_alive() {
  local pid="${1:-}"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

reap_save_jobs() {
  local job pid dest
  (
    shopt -s nullglob
    for job in "$SAVE_JOBS_DIR"/*/; do
      printf '%s\n' "$job"
    done
  ) | while IFS= read -r job; do
    [[ -d $job ]] || continue
    pid=""
    [[ -r $job/pid ]] && pid=$(<"$job/pid")
    if [[ -z $pid ]] || job_pid_alive "$pid"; then
      continue
    fi
    dest=""
    [[ -r $job/dest ]] && dest=$(<"$job/dest")
    if [[ -n $dest && -e $dest ]]; then
      write_activity "$(activity_value running)" "$(activity_value monitor)" "$(activity_value seconds)" "$(activity_value audio)" "$dest"
    else
      notify "Replay save failed" "A Clip did not finish writing."
    fi
    rm -rf "$job"
  done
}

saving_count() {
  local job pid count=0
  while IFS= read -r job; do
    [[ -d $job ]] || continue
    pid=""
    [[ -r $job/pid ]] && pid=$(<"$job/pid")
    if [[ -z $pid ]] || job_pid_alive "$pid"; then
      count=$((count + 1))
    fi
  done < <(
    shopt -s nullglob
    for job in "$SAVE_JOBS_DIR"/*/; do
      printf '%s\n' "$job"
    done
  )
  printf '%s\n' "$count"
}

discard_old_segments() {
  local window="${1:-$CONFIG_SECONDS}"
  local now cutoff end path
  now=$(now_epoch)
  cutoff=$((now - window))
  [[ -r $SEGMENT_INDEX ]] || return 0
  local kept=""
  while IFS='|' read -r end path || [[ -n ${end:-} ]]; do
    [[ -n ${end:-} ]] || continue
    if (( end < cutoff )); then
      rm -f "$path"
      continue
    fi
    kept+="${end}|${path}"$'\n'
  done < "$SEGMENT_INDEX"
  if [[ -n $kept ]]; then
    printf '%s' "$kept" | write_segment_index
  else
    rm -f "$SEGMENT_INDEX"
  fi
}

flush_segment() {
  local restart="${1:-}"
  buffer_running || return 0
  local src dest end started seconds lived duration audio
  src=$(save_replay_path "" "$restart") || return 0
  [[ -e $src ]] || return 0
  mkdir -p "$SEGMENT_DIR"
  chmod 700 "$SEGMENT_DIR"
  end=$(now_epoch)
  dest=$(mktemp "$SEGMENT_DIR/seg-${end}-XXXXXX")
  mv -f "$src" "$dest" || { cp -f "$src" "$dest" && rm -f "$src"; }
  started=$(activity_value started)
  seconds=$(activity_value seconds)
  [[ $seconds =~ ^[0-9]+$ ]] || seconds=$CONFIG_SECONDS
  duration=$seconds
  if [[ $started =~ ^[0-9]+$ ]] && (( end > started )); then
    lived=$((end - started))
    (( lived < duration )) && duration=$lived
  elif [[ $started =~ ^[0-9]+$ ]] && (( end == started )); then
    duration=1
  fi
  audio=$(activity_value audio)
  [[ -n $audio ]] || audio=$CONFIG_AUDIO
  local crop
  crop=$(activity_value crop)
  [[ -n $crop ]] || crop=full
  local row
  row=$(printf '%s|%s|%s|%s|%s\n' "$end" "$dest" "$duration" "$audio" "$crop")
  if [[ -r $SEGMENT_INDEX ]]; then
    { cat "$SEGMENT_INDEX"; printf '%s' "$row"; } | write_segment_index
  else
    printf '%s' "$row" | write_segment_index
  fi
  discard_old_segments
}

live_capture_differs() {
  local monitor="$1"
  [[ $(activity_value monitor) != "$monitor" ]] && return 0
  [[ $(activity_value seconds) != "$CONFIG_SECONDS" ]] && return 0
  [[ $(activity_value audio) != "$CONFIG_AUDIO" ]] && return 0
  if [[ $CONFIG_AUDIO == window || $CONFIG_AUDIO == window-mic ]]; then
    local want_app
    want_app="${AUDIO_APP:-$(subject_audio_app)}"
    [[ $(activity_value audio_app) != "$want_app" ]] && return 0
  fi
  [[ $(activity_value codec) != "$CONFIG_CODEC" ]] && return 0
  [[ $(activity_value fps) != "$CONFIG_FPS" ]] && return 0
  [[ $(activity_value quality) != "$CONFIG_QUALITY" ]] && return 0
  [[ $(activity_value cursor) != "$CONFIG_CURSOR" ]] && return 0
  [[ $(activity_value framerate_mode) != "$CONFIG_FRAMERATE_MODE" ]] && return 0
  [[ $(activity_value bitrate_mode) != "$CONFIG_BITRATE_MODE" ]] && return 0
  [[ $(activity_value mode) != "$CONFIG_MODE" ]] && return 0
  [[ $(activity_value capture_extent) != "$CONFIG_CAPTURE_EXTENT" ]] && return 0
  [[ $(activity_value region) != "$CONFIG_REGION" ]] && return 0
  return 1
}

our_recorder_pids() {
  local pid=""
  if [[ -n ${SHADOWPLAY_FAKE_DIR:-} ]]; then
    pid=$(read_pid 2>/dev/null || true)
    [[ -n $pid ]] && printf '%s\n' "$pid"
    return 0
  fi
  pgrep -f "^${PROCESS_NAME}( |$)" 2>/dev/null || true
  pgrep -f '^omarchy-shadowplay-gsr( |$)' 2>/dev/null || true
}

stop_recorder() {
  local pid extra
  pid=$(read_pid 2>/dev/null || true)
  if cli_running; then
    "$GSR_CLI_BIN" -ipc "$IPC" stop >/dev/null 2>&1 || true
  fi
  if [[ -n $pid ]] && pid_alive "$pid"; then
    kill -INT "$pid" 2>/dev/null || true
  fi
  while IFS= read -r extra; do
    [[ -n $extra ]] || continue
    kill -INT "$extra" 2>/dev/null || true
  done < <(our_recorder_pids)
  wait_until_stopped "$pid" || true
  if [[ -n $pid ]] && pid_alive "$pid"; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
  while IFS= read -r extra; do
    [[ -n $extra ]] || continue
    kill -KILL "$extra" 2>/dev/null || true
  done < <(our_recorder_pids)
  rm -f "$PID_FILE" "$IPC"
}

launch_recorder() {
  command -v "$GSR_BIN" >/dev/null 2>&1 || die "gpu-screen-recorder is not installed"
  command -v "$GSR_CLI_BIN" >/dev/null 2>&1 || die "gsr-cli is not installed"

  if [[ -n $(our_recorder_pids) ]]; then
    stop_recorder
  fi

  if capture_device_busy; then
    die_device_busy
  fi

  local monitor seconds audio region=""
  seconds=$CONFIG_SECONDS
  audio=$CONFIG_AUDIO
  if [[ $CONFIG_MODE == region ]]; then
    [[ -n $CONFIG_REGION ]] || die "Region Mode needs a rectangle. Pick a region first."
    validate_region "$CONFIG_REGION"
    monitor=$(region_host_monitor "$CONFIG_REGION")
    region=$CONFIG_REGION
  else
    monitor=$(resolve_monitor)
  fi
  mkdir -p "$GSR_OUTPUT_DIR"
  chmod 700 "$GSR_OUTPUT_DIR"

  local -a gsr_args=()
  if [[ $CONFIG_MODE == region ]]; then
    gsr_args+=(-w region -region "$region")
  else
    gsr_args+=(-w "$monitor")
  fi
  gsr_args+=(
    -f "$CONFIG_FPS"
    -fm "$CONFIG_FRAMERATE_MODE"
    -k "$CONFIG_CODEC"
    -bm "$CONFIG_BITRATE_MODE"
    -q "$CONFIG_QUALITY"
    -r "$seconds"
    -c mp4
    -replay-storage ram
    -fallback-cpu-encoding yes
    -ipc "$IPC"
    -o "$GSR_OUTPUT_DIR"
  )
  if [[ $CONFIG_CURSOR == false ]]; then
    gsr_args+=(-cursor no)
  fi
  AUDIO_APP=""
  AUDIO_APP_SET=1
  if [[ $audio == window || $audio == window-mic ]]; then
    if [[ $CONFIG_MODE != follow && $CONFIG_MODE != pin ]]; then
      audio=$([[ $audio == window-mic ]] && echo both || echo desktop)
    else
      AUDIO_APP=$(subject_audio_app)
      AUDIO_APP=${AUDIO_APP%%$'\n'*}
      AUDIO_APP=${AUDIO_APP//|/}
    fi
  fi
  case "$audio" in
  desktop) gsr_args+=(-a default_output -ac aac) ;;
  both) gsr_args+=(-a "default_output|default_input" -ac aac) ;;
  window)
    [[ -n $AUDIO_APP ]] || die "couldn't find audio for this window"
    gsr_args+=(-a "app:${AUDIO_APP}" -ac aac)
    ;;
  window-mic)
    [[ -n $AUDIO_APP ]] || die "couldn't find audio for this window"
    gsr_args+=(-a "app:${AUDIO_APP}|default_input" -ac aac)
    ;;
  none) ;;
  *) die "invalid audio setting: $audio" ;;
  esac

  rm -f "$IPC"
  mkdir -p "$STATE_DIR"
  : > "$LOG_FILE"
  bash -c '
    lockfd="$1"
    shift
    if [[ $lockfd =~ ^[0-9]+$ ]]; then
      eval "exec ${lockfd}<&-"
    fi
    exec 8<&- 9<&-
    exec -a omarchy-instant-replay-gsr "$@"
  ' bash "${STATE_LOCK_FD:-}" "$GSR_BIN" "${gsr_args[@]}" >>"$LOG_FILE" 2>&1 &
  local pid=$!
  write_pid_file "$pid"

  if ! wait_until_running "$pid"; then
    local log
    log=$(tail -n 20 "$LOG_FILE" 2>/dev/null || true)
    if [[ -n $pid ]] && pid_alive "$pid"; then
      kill -INT "$pid" 2>/dev/null || true
      wait_until_stopped "$pid" || true
    fi
    rm -f "$PID_FILE"
    if capture_device_busy || log_looks_busy "$log"; then
      die_device_busy "$log"
    fi
    if [[ -n $log ]]; then
      die "replay buffer failed to start"$'\n'"$log"
    fi
    die "replay buffer failed to start"
  fi

  if [[ $CONFIG_MODE == follow || $CONFIG_MODE == pin ]]; then
    write_activity true "$monitor" "$seconds" "$audio" "$(activity_value last_clip)" "$(now_epoch)" live "" "" "" full
  else
    write_activity true "$monitor" "$seconds" "$audio" "$(activity_value last_clip)" "$(now_epoch)" live "-" "-" "-" full
  fi
}

split_and_restart() {
  flush_segment
  stop_recorder
  launch_recorder
}

segment_crop_filter() {
  local spec="$1"
  if [[ $spec =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]]; then
    printf 'crop=%s:%s:%s:%s,' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
  fi
}

live_crop_spec() {
  local phase crop
  phase=$(activity_value phase)
  crop=$(activity_value crop)
  if [[ $CONFIG_CAPTURE_EXTENT != window || $phase == linger ]]; then
    printf 'full\n'
    return
  fi
  [[ -n $crop ]] || crop=full
  printf '%s\n' "$crop"
}

join_clip() {
  local live="$1"
  local out="$2"
  local window="${3:-$CONFIG_SECONDS}"
  local index="${4:-$SEGMENT_INDEX}"
  local live_crop="${5:-}"
  local live_audio="${6:-$CONFIG_AUDIO}"
  local canvas="${7:-$(clip_resolution_size)}"
  local scale="${8:-$CONFIG_CLIP_SCALE}"
  local now cutoff end path duration audio crop trim kept i fc maps cropf vf
  local -a paths=() trims=() durs=() auds=() crops=()
  now=$(now_epoch)
  cutoff=$((now - window))
  if [[ -n $index && -r $index ]]; then
    while IFS='|' read -r end path duration audio crop || [[ -n ${end:-} ]]; do
      [[ -n ${path:-} && -e $path ]] || continue
      [[ $duration =~ ^[0-9]+$ ]] || duration=$window
      [[ -n $audio ]] || audio=none
      [[ -n $crop ]] || crop=full
      (( duration > 0 )) || continue
      trim=0
      if (( end - duration < cutoff )); then
        trim=$((cutoff - (end - duration)))
      fi
      if (( trim >= duration )); then
        continue
      fi
      kept=$((duration - trim))
      paths+=("$path")
      trims+=("$trim")
      durs+=("$kept")
      auds+=("$audio")
      crops+=("$crop")
    done < "$index"
  fi
  paths+=("$live")
  trims+=(0)
  durs+=("$window")
  [[ -n $live_audio ]] || live_audio=$CONFIG_AUDIO
  [[ -n $live_crop ]] || live_crop=$(live_crop_spec)
  auds+=("$live_audio")
  crops+=("$live_crop")
  command -v "$FFMPEG_BIN" >/dev/null 2>&1 || die "ffmpeg is not installed"
  local keep_audio=0
  for audio in "${auds[@]}"; do
    if [[ $audio != none ]]; then
      keep_audio=1
      break
    fi
  done
  if (( ${#paths[@]} == 1 )); then
    cropf=$(segment_crop_filter "${crops[0]}")
    vf=$(clip_layout_filter "$cropf" "$canvas" "$scale")
    local -a ff_single=(-hide_banner -loglevel error -y)
    if (( ${trims[0]} > 0 )); then
      ff_single+=(-ss "${trims[0]}")
    fi
    ff_single+=(-i "${paths[0]}" -vf "$vf")
    if (( keep_audio )); then
      ff_single+=(-c:v libx264 -preset veryfast -crf 18 -c:a aac -b:a 192k "$out")
    else
      ff_single+=(-c:v libx264 -preset veryfast -crf 18 -an "$out")
    fi
    run_ffmpeg "${ff_single[@]}" || die "failed to join replay segments"
    rm -f "$live"
    printf '%s\n' "$out"
    return
  fi
  fc=""
  maps=""
  for i in "${!paths[@]}"; do
    cropf=$(segment_crop_filter "${crops[$i]}")
    vf=$(clip_layout_filter "$cropf" "$canvas" "$scale")
    fc+="[$i:v]${vf}[v$i];"
    maps+="[v$i]"
    if (( keep_audio )); then
      if [[ ${auds[$i]} != none ]]; then
        fc+="[$i:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS[a$i];"
      else
        fc+="anullsrc=r=48000:cl=stereo:d=${durs[$i]},aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS[a$i];"
      fi
      maps+="[a$i]"
    fi
  done
  local -a ff_args=(-hide_banner -loglevel error -y)
  for i in "${!paths[@]}"; do
    if (( ${trims[$i]} > 0 )); then
      ff_args+=(-ss "${trims[$i]}")
    fi
    ff_args+=(-i "${paths[$i]}")
  done
  if (( keep_audio )); then
    fc+="${maps}concat=n=${#paths[@]}:v=1:a=1[v][a]"
    ff_args+=(-filter_complex "$fc" -map "[v]" -map "[a]" -c:v libx264 -preset veryfast -crf 18 -c:a aac -b:a 192k "$out")
  else
    fc+="${maps}concat=n=${#paths[@]}:v=1:a=0[v]"
    ff_args+=(-filter_complex "$fc" -map "[v]" -an -c:v libx264 -preset veryfast -crf 18 "$out")
  fi
  run_ffmpeg "${ff_args[@]}" || die "failed to join replay segments"
  rm -f "$live"
  printf '%s\n' "$out"
}

run_ffmpeg() {
  command -v "$FFMPEG_BIN" >/dev/null 2>&1 || die "ffmpeg is not installed"
  "$TIMEOUT_BIN" -k 2 "$FFMPEG_TIMEOUT" "$FFMPEG_BIN" "$@"
}


bounded_stdout() {
  local max="$1" out
  shift
  out=$(
    set -o pipefail
    "$TIMEOUT_BIN" -k 1 8 "$@" 2>/dev/null | "$HEAD_BIN" -c $((max + 1))
  ) || {
    printf '[]\n'
    return 1
  }
  if [[ ${#out} -gt $max ]]; then
    printf '[]\n'
    return 1
  fi
  printf '%s' "$out"
}

windows_json() {
  if [[ -n ${SHADOWPLAY_WINDOWS_JSON:-} ]]; then
    printf '%s\n' "$SHADOWPLAY_WINDOWS_JSON"
    return
  fi
  if [[ -n ${SHADOWPLAY_WINDOWS_FILE:-} && -r ${SHADOWPLAY_WINDOWS_FILE} ]]; then
    "$HEAD_BIN" -c $((HYPR_JSON_MAX + 1)) "$SHADOWPLAY_WINDOWS_FILE"
    return
  fi
  if command -v "$HYPRCTL_BIN" >/dev/null 2>&1; then
    bounded_stdout "$HYPR_JSON_MAX" "$HYPRCTL_BIN" clients -j || true
    return
  fi
  printf '[]\n'
}

monitors_json() {
  if [[ -n ${SHADOWPLAY_MONITORS_JSON:-} ]]; then
    printf '%s\n' "$SHADOWPLAY_MONITORS_JSON"
    return
  fi
  if [[ -n ${SHADOWPLAY_MONITORS_FILE:-} && -r ${SHADOWPLAY_MONITORS_FILE} ]]; then
    "$HEAD_BIN" -c $((HYPR_JSON_MAX + 1)) "$SHADOWPLAY_MONITORS_FILE"
    return
  fi
  if command -v "$HYPRCTL_BIN" >/dev/null 2>&1; then
    bounded_stdout "$HYPR_JSON_MAX" "$HYPRCTL_BIN" monitors -j || true
    return
  fi
  printf '[]\n'
}

is_chrome_class() {
  local raw="${1,,}" last
  last=${raw##*.}
  case "$raw" in
  org.quickshell|quickshell) return 0 ;;
  esac
  case "$last" in
  waybar|walker|hyprlock|quickshell)
    return 0
    ;;
  esac
  return 1
}

is_sticky_glance_class() {
  local class="${1,,}"
  class=${class##*.}
  case "$class" in
  discord)
    return 0
    ;;
  esac
  return 1
}

rule_matches_class() {
  local rule="$1" class="$2" initial="$3"
  [[ -n $rule ]] || return 1
  [[ $class =~ $rule ]] && return 0
  [[ -n $initial && $initial != "$class" && $initial =~ $rule ]] && return 0
  return 1
}

window_allowed() {
  local class="$1" initial="${2:-$1}"
  [[ -n $class || -n $initial ]] || return 1
  case "$CONFIG_FILTER" in
  allowlist)
    local rule
    [[ -n $CONFIG_MATCH_LIST ]] || return 1
    while IFS= read -r rule; do
      [[ -n $rule ]] || continue
      rule_matches_class "$rule" "$class" "$initial" && return 0
    done <<<"$CONFIG_MATCH_LIST"
    return 1
    ;;
  denylist)
    local rule
    while IFS= read -r rule; do
      [[ -n $rule ]] || continue
      rule_matches_class "$rule" "$class" "$initial" && return 1
    done <<<"$CONFIG_BLACKLIST"
    return 0
    ;;
  all)
    is_chrome_class "$class" && return 1
    is_chrome_class "$initial" && return 1
    is_sticky_glance_class "$class" && return 1
    is_sticky_glance_class "$initial" && return 1
    return 0
    ;;
  *)
    is_chrome_class "$class" && return 1
    return 0
    ;;
  esac
}

match_list_priority_line() {
  local rule line klass initial mon addr focused
  [[ -n $CONFIG_MATCH_LIST ]] || return 1
  while IFS= read -r rule; do
    [[ -n $rule ]] || continue
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      IFS='|' read -r klass initial mon addr focused _ <<<"$line"
      if rule_matches_class "$rule" "$klass" "$initial"; then
        printf '%s\n' "$line"
        return 0
      fi
    done < <(parse_windows)
  done <<<"$CONFIG_MATCH_LIST"
  return 1
}

parse_windows() {
  if [[ ${WINDOWS_SNAPSHOT:-0} == 1 && ${PARSE_WINDOWS_CACHE_SET:-0} == 1 ]]; then
    [[ -n $PARSE_WINDOWS_CACHE ]] && printf '%s\n' "$PARSE_WINDOWS_CACHE"
    return
  fi
  local clients monitors names rows
  clients=$(windows_json)
  monitors=$(monitors_json)
  names=$(list_monitor_names)
  rows=$(
    SHADOWPLAY_MONITORS_JSON="$monitors" SHADOWPLAY_MONITOR_NAMES="$names" "$PYTHON_BIN" -I -c '
import json, os, sys
def load(raw):
    try:
        data = json.loads(raw or "[]")
    except Exception:
        return []
    if isinstance(data, dict):
        return [data]
    return data if isinstance(data, list) else []
clients = load(sys.stdin.read())
monitors = load(os.environ.get("SHADOWPLAY_MONITORS_JSON", "[]"))
id_to_name = {}
gsr_names = [n for n in os.environ.get("SHADOWPLAY_MONITOR_NAMES", "").splitlines() if n]
for i, name in enumerate(gsr_names):
    id_to_name[str(i)] = name
    id_to_name[name] = name
for mon in monitors:
    if not isinstance(mon, dict):
        continue
    name = str(mon.get("name") or "")
    mid = mon.get("id")
    if name:
        id_to_name[name] = name
    if name and mid is not None:
        id_to_name[str(mid)] = name
focus = os.environ.get("SHADOWPLAY_FOCUSED_ADDRESS", "")
best_hist = None
rows = []
for item in clients:
    if not isinstance(item, dict):
        continue
    klass = str(item.get("class") or item.get("initialClass") or "")
    initial = str(item.get("initialClass") or klass)
    raw_mon = item.get("monitor")
    monitor = ""
    if raw_mon is not None and raw_mon != "":
        key = str(raw_mon)
        monitor = id_to_name.get(key, key if not str(raw_mon).isdigit() else "")
        if not monitor and str(raw_mon).isdigit():
            monitor = id_to_name.get(str(raw_mon), "")
    address = str(item.get("address") or "")
    hist = item.get("focusHistoryID")
    focused = item.get("focused") is True or item.get("active") is True
    if hist == 0:
        focused = True
    if focus and address == focus:
        focused = True
    title = str(item.get("title") or item.get("initialTitle") or "")
    at = item.get("at") or item.get("at_")
    size = item.get("size")
    atx = aty = ww = hh = ""
    def px(value):
        try:
            return str(int(float(value)))
        except (TypeError, ValueError):
            return ""
    if isinstance(at, (list, tuple)) and len(at) >= 2:
        atx, aty = px(at[0]), px(at[1])
    elif isinstance(at, str) and "," in at:
        atx, aty = px(at.split(",", 1)[0]), px(at.split(",", 1)[1])
    if isinstance(size, (list, tuple)) and len(size) >= 2:
        ww, hh = px(size[0]), px(size[1])
    elif isinstance(size, str) and "x" in size:
        ww, hh = px(size.split("x", 1)[0]), px(size.split("x", 1)[1])
    if item.get("x") is not None:
        atx = px(item.get("x"))
    if item.get("y") is not None:
        aty = px(item.get("y"))
    if item.get("w") is not None:
        ww = px(item.get("w"))
    if item.get("width") is not None:
        ww = px(item.get("width"))
    if item.get("h") is not None:
        hh = px(item.get("h"))
    if item.get("height") is not None:
        hh = px(item.get("height"))
    pid = str(item.get("pid") or "")
    rows.append((klass, initial, monitor, address, focused, hist if isinstance(hist, int) else 10**9, title, atx, aty, ww, hh, pid))
if not any(r[4] for r in rows):
    with_hist = [r for r in rows if r[5] != 10**9]
    if with_hist:
        winner = min(with_hist, key=lambda r: r[5])
        rows = [r[:4] + (r is winner,) + r[5:] for r in rows]
for klass, initial, monitor, address, focused, _hist, title, atx, aty, ww, hh, pid in rows:
    print("|".join([klass.replace("|"," "), initial.replace("|"," "), monitor.replace("|"," "), address.replace("|"," "), "1" if focused else "0", title.replace("|"," "), atx.replace("|"," "), aty.replace("|"," "), ww.replace("|"," "), hh.replace("|"," "), pid.replace("|"," ")]))
' <<<"$clients"
  )
  if [[ ${WINDOWS_SNAPSHOT:-0} == 1 ]]; then
    PARSE_WINDOWS_CACHE=$rows
    PARSE_WINDOWS_CACHE_SET=1
  fi
  # Command substitution strips a trailing newline; while-read skips a last line
  # that does not end in a newline.
  [[ -n $rows ]] && printf '%s\n' "$rows"
}

focused_window_line() {
  local line klass initial mon addr focused
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass initial mon addr focused _ <<<"$line"
    if [[ $focused == 1 ]]; then
      printf '%s\n' "$line"
      return 0
    fi
  done < <(parse_windows)
  return 1
}

window_exists() {
  local address="$1" class="$2" monitor="$3"
  local line klass mon addr
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass _ mon addr _ _ <<<"$line"
    if [[ -n $address && $addr == "$address" ]]; then
      return 0
    fi
    if [[ -z $address && $klass == "$class" && ( -z $monitor || $mon == "$monitor" ) ]]; then
      return 0
    fi
  done < <(parse_windows)
  return 1
}

window_line_by_address() {
  local address="$1"
  local line klass mon addr
  [[ -n $address ]] || return 1
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass _ mon addr _ <<<"$line"
    if [[ $addr == "$address" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
  done < <(parse_windows)
  return 1
}

find_class_on_monitor() {
  local class="$1" monitor="$2"
  local line klass mon addr
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass _ mon addr _ _ <<<"$line"
    if [[ $klass == "$class" && $mon == "$monitor" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
  done < <(parse_windows)
  return 1
}

window_pid() {
  local address="$1" class="$2"
  local line klass initial mon addr focused title atx aty ww hh pid
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass initial mon addr focused title atx aty ww hh pid <<<"$line"
    if [[ -n $address && $addr == "$address" ]]; then
      printf '%s\n' "$pid"
      return 0
    fi
    if [[ -z $address && $klass == "$class" ]]; then
      printf '%s\n' "$pid"
      return 0
    fi
  done < <(parse_windows)
  return 1
}

application_audio_name() {
  local pid="${1:-}" class="${2:-}"
  SHADOWPLAY_LOOKUP_PID="$pid" SHADOWPLAY_LOOKUP_CLASS="$class" SHADOWPLAY_GSR_BIN="$GSR_BIN" "$PYTHON_BIN" -I -c '
import json, os, re, subprocess

GENERIC = {"com", "org", "io", "www", "app", "browser", "bin", "client", "desktop", "helper", "sandbox"}

def tokens(value):
    value = (value or "").lower().replace("_", "-")
    return [part for part in re.split(r"[^a-z0-9]+", value) if part and part not in GENERIC]

def ancestors(pid):
    found = set()
    cur = str(pid or "")
    while cur and cur != "0" and cur not in found:
        found.add(cur)
        try:
            with open("/proc/%s/stat" % cur, "r", encoding="utf-8") as fh:
                st = fh.read()
            close = st.rfind(")")
            parts = st[close + 1:].split()
            cur = parts[1] if len(parts) > 1 else ""
        except Exception:
            break
    return found

def last_component(klass):
    klass = (klass or "").strip()
    if not klass:
        return ""
    return klass.split(".")[-1]

def derive_name(klass):
    last = last_component(klass)
    if not last:
        return ""
    parts = [p for p in re.split(r"[^A-Za-z0-9]+", last) if p]
    for part in parts:
        if part.lower() not in GENERIC:
            return part
    return last

def gsr_canonical(name, gsr_apps):
    if not name:
        return ""
    lower = name.lower()
    for app in gsr_apps:
        if app.lower() == lower:
            return app
    return name

def stream_from_props(props):
    if not isinstance(props, dict):
        return None
    name = str(props.get("application.name") or "").strip()
    node = str(props.get("node.name") or "").strip()
    if not name:
        name = node
    if not name:
        return None
    if str(props.get("media.role") or "").lower() == "event":
        return None
    return {
        "name": name,
        "pid": str(props.get("application.process.id") or "").strip(),
        "binary": str(props.get("application.process.binary") or "").strip(),
    }

def streams_from_pactl(items):
    out = []
    if not isinstance(items, list):
        return out
    for item in items:
        if not isinstance(item, dict):
            continue
        row = stream_from_props(item.get("properties") or item.get("proplist") or {})
        if row:
            out.append(row)
    return out

def streams_from_pw(data):
    out = []
    if not isinstance(data, list):
        return out
    for obj in data:
        if not isinstance(obj, dict):
            continue
        info = obj.get("info") or {}
        props = info.get("props") or {}
        if not isinstance(props, dict):
            continue
        if props.get("media.class") != "Stream/Output/Audio":
            continue
        row = stream_from_props(props)
        if row:
            out.append(row)
    return out

pid = str(os.environ.get("SHADOWPLAY_LOOKUP_PID") or "")
klass = str(os.environ.get("SHADOWPLAY_LOOKUP_CLASS") or "")
override = os.environ.get("SHADOWPLAY_APP_AUDIO")
if override:
    print(override)
    raise SystemExit
raw = os.environ.get("SHADOWPLAY_APP_AUDIO_JSON") or ""
if raw:
    try:
        mapping = json.loads(raw)
    except Exception:
        mapping = {}
    if not isinstance(mapping, dict):
        mapping = {}
    if pid and mapping.get("pid:" + pid):
        print(mapping["pid:" + pid])
        raise SystemExit
    key = klass.lower()
    print(mapping.get("class:" + key) or mapping.get(klass) or mapping.get(key) or "")
    raise SystemExit

gsr = os.environ.get("SHADOWPLAY_GSR_BIN") or "gpu-screen-recorder"
try:
    gsr_apps = [line.strip() for line in subprocess.check_output([gsr, "--list-application-audio"], text=True, stderr=subprocess.DEVNULL, timeout=5).splitlines() if line.strip()]
except Exception:
    gsr_apps = []

streams = []
sink_raw = os.environ.get("SHADOWPLAY_SINK_INPUTS_JSON") or ""
if sink_raw:
    try:
        streams.extend(streams_from_pactl(json.loads(sink_raw)))
    except Exception:
        pass
pw_raw = os.environ.get("SHADOWPLAY_PW_DUMP_JSON") or ""
if pw_raw:
    try:
        streams.extend(streams_from_pw(json.loads(pw_raw)))
    except Exception:
        pass
if not sink_raw and not pw_raw and not os.environ.get("SHADOWPLAY_FAKE_DIR"):
    try:
        streams.extend(streams_from_pactl(json.loads(subprocess.check_output(
            ["pactl", "--format=json", "list", "sink-inputs"],
            text=True, stderr=subprocess.DEVNULL, timeout=5))))
    except Exception:
        pass
    try:
        dump = subprocess.check_output(["/usr/bin/pw-dump"], text=True, stderr=subprocess.DEVNULL, timeout=5)
        if len(dump) > 2000000:
            dump = ""
        if dump:
            streams.extend(streams_from_pw(json.loads(dump)))
    except Exception:
        pass

class_tokens = set(tokens(klass)) | set(tokens(last_component(klass)))
best_name, best_score = "", -1
for item in streams:
    name = item.get("name") or ""
    proc_id = item.get("pid") or ""
    binary = item.get("binary") or ""
    if not name:
        continue
    score = 0
    if pid and proc_id == pid:
        score = 100
    elif pid and proc_id and pid in ancestors(proc_id):
        score = 90
    else:
        overlap = len(class_tokens & (set(tokens(binary)) | set(tokens(name))))
        if overlap:
            score = 50 + overlap * 10
    canon = gsr_canonical(name, gsr_apps)
    if canon in gsr_apps or name in gsr_apps:
        score += 5
        name = canon
    if score > best_score:
        best_name, best_score = name, score
if best_score >= 50:
    print(gsr_canonical(best_name, gsr_apps))
    raise SystemExit

best_name, best_overlap = "", 0
for name in gsr_apps:
    overlap = len(class_tokens & set(tokens(name)))
    if overlap > best_overlap:
        best_name, best_overlap = name, overlap
if best_overlap >= 1:
    print(best_name)
    raise SystemExit

print(gsr_canonical(derive_name(klass), gsr_apps))
'
}

subject_audio_app() {
  local class address pid name
  case "$CONFIG_AUDIO" in
  window|window-mic) ;;
  *) printf ''; return 0 ;;
  esac
  class="${CAPTURE_SUBJECT_CLASS:-$(activity_value subject_class)}"
  address="${CAPTURE_SUBJECT_ADDRESS:-$(activity_value subject_address)}"
  pid=$(window_pid "$address" "$class" || true)
  name=$(application_audio_name "$pid" "$class" || true)
  name=${name%%$'\n'*}
  printf '%s' "$name"
}

follow_session_active() {
  local phase
  phase=$(activity_value phase)
  [[ $phase == armed || $phase == live || $phase == linger ]]
}

go_armed() {
  if buffer_running; then
    stop_recorder
    discard_all_segments
  fi
  write_activity false "$(activity_value monitor)" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "" armed "-" "-" "-" "-"
}

go_live_on() {
  local monitor="$1" class="$2" address="$3"
  local saved="$CONFIG_MONITOR"
  local started old_class old_addr
  old_class=$(activity_value subject_class)
  old_addr=$(activity_value subject_address)
  CAPTURE_SUBJECT_CLASS="$class"
  CAPTURE_SUBJECT_ADDRESS="$address"
  AUDIO_APP=$(subject_audio_app)
  AUDIO_APP_SET=1
  CONFIG_MONITOR="$monitor"
  started=$(activity_value started)
  if buffer_running; then
    if live_capture_differs "$monitor"; then
      split_and_restart
      started=$(activity_value started)
    elif [[ $CONFIG_AUDIO == window || $CONFIG_AUDIO == window-mic ]] && [[ $old_class != "$class" ]]; then
      # GSR pins -a app:name at start. A new Subject is a new app stream.
      split_and_restart
      started=$(activity_value started)
    elif [[ $old_class != "$class" || $old_addr != "$address" ]]; then
      # Same KMS target, new Subject: dump the ring with the old crop and clear it.
      # GSR cannot move a capture rectangle over IPC.
      flush_segment restart
      started=$(now_epoch)
    fi
  else
    launch_recorder
    started=$(activity_value started)
  fi
  CONFIG_MONITOR="$saved"
  write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$started" live "$class" "$address" "-" "$(window_crop_spec "$address" "$class" "$monitor")"
}

window_crop_spec() {
  local address="$1" class="$2" monitor="$3"
  local line klass mon addr atx aty ww hh mx my mw mh relx rely
  if [[ $CONFIG_CAPTURE_EXTENT != window ]]; then
    printf 'full\n'
    return
  fi
  line=""
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS='|' read -r klass _ mon addr _ _ atx aty ww hh _ <<<"$line"
    if [[ -n $address && $addr == "$address" ]]; then
      break
    fi
    if [[ -z $address && $klass == "$class" && ( -z $monitor || $mon == "$monitor" ) ]]; then
      break
    fi
    line=""
  done < <(parse_windows)
  [[ -n $line ]] || { printf 'full\n'; return; }
  mx=""; my=""; mw=""; mh=""
  while IFS='|' read -r name w h x y; do
    [[ $name == "$mon" ]] || continue
    mw=$w; mh=$h; mx=$x; my=$y
    break
  done < <(monitor_geometry_lines)
  [[ $ww =~ ^[0-9]+$ && $hh =~ ^[0-9]+$ ]] || { printf 'full\n'; return; }
  relx=0
  rely=0
  if [[ $atx =~ ^-?[0-9]+$ && $mx =~ ^-?[0-9]+$ ]]; then
    relx=$((atx - mx))
  fi
  if [[ $aty =~ ^-?[0-9]+$ && $my =~ ^-?[0-9]+$ ]]; then
    rely=$((aty - my))
  fi
  if (( relx < 0 )); then relx=0; fi
  if (( rely < 0 )); then rely=0; fi
  if [[ $mw =~ ^[0-9]+$ && $mh =~ ^[0-9]+$ ]]; then
    if (( relx + ww > mw )); then ww=$((mw - relx)); fi
    if (( rely + hh > mh )); then hh=$((mh - rely)); fi
    if (( ww <= 0 || hh <= 0 )); then
      printf 'full\n'
      return
    fi
    if (( ww >= mw && hh >= mh && relx == 0 && rely == 0 )); then
      printf 'full\n'
      return
    fi
  fi
  # yuv420 crop needs even origin and size.
  if (( relx % 2 != 0 )); then relx=$((relx + 1)); fi
  if (( rely % 2 != 0 )); then rely=$((rely + 1)); fi
  if (( ww % 2 != 0 )); then ww=$((ww - 1)); fi
  if (( hh % 2 != 0 )); then hh=$((hh - 1)); fi
  if (( ww <= 0 || hh <= 0 )); then
    printf 'full\n'
    return
  fi
  printf '%sx%s+%s+%s\n' "$ww" "$hh" "$relx" "$rely"
}

enter_linger() {
  local until
  until=$(( $(now_epoch) + CONFIG_SECONDS ))
  flush_segment restart
  write_activity true "$(activity_value monitor)" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(now_epoch)" linger "$(activity_value subject_class)" "$(activity_value subject_address)" "$until" full
}

cmd_follow_tick() {
  load_config
  [[ $CONFIG_MODE == follow ]] || return 0
  follow_session_active || return 0
  WINDOWS_SNAPSHOT=1
  PARSE_WINDOWS_CACHE_SET=0

  local phase monitor subject_class subject_address linger_until
  phase=$(activity_value phase)
  monitor=$(activity_value monitor)
  subject_class=$(activity_value subject_class)
  subject_address=$(activity_value subject_address)
  linger_until=$(activity_value linger_until)

  local line class initial win_mon win_addr focused
  line=$(focused_window_line || true)
  if [[ -n $line ]]; then
    IFS='|' read -r class initial win_mon win_addr focused _ <<<"$line"
  else
    class=""
    initial=""
    win_mon=""
    win_addr=""
  fi

  local subject_alive="false" subject_initial=""
  subject_initial="$subject_class"
  if [[ -n $subject_address ]] && window_exists "$subject_address" "$subject_class" ""; then
    subject_alive="true"
  elif [[ -n $subject_class ]] && window_exists "" "$subject_class" "$monitor"; then
    subject_alive="true"
  fi

  adopt_follow_subject() {
    local tgt_mon="$1" tgt_class="$2" tgt_addr="$3"
    if [[ $phase == linger && $tgt_class == "$subject_class" && $tgt_mon == "$monitor" ]]; then
      write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(activity_value started)" live "$tgt_class" "$tgt_addr" "-" "$(window_crop_spec "$tgt_addr" "$tgt_class" "$tgt_mon")"
      return 0
    fi
    go_live_on "$tgt_mon" "$tgt_class" "$tgt_addr"
  }

  if [[ -n $class ]] && window_allowed "$class" "$initial"; then
    adopt_follow_subject "$win_mon" "$class" "$win_addr"
    return 0
  fi

  # Glance at a non-match: Sticky while the last Subject still matches.
  if [[ $subject_alive == true ]] && window_allowed "$subject_class" "$subject_initial"; then
    if [[ $phase == linger ]]; then
      write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(activity_value started)" live "$subject_class" "$subject_address" "-" "$(window_crop_spec "$subject_address" "$subject_class" "$monitor")"
    elif [[ $phase == live ]]; then
      write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(activity_value started)" live "$subject_class" "$subject_address" "-" "$(window_crop_spec "$subject_address" "$subject_class" "$monitor")"
    fi
    return 0
  fi

  if [[ $CONFIG_FILTER == allowlist ]]; then
    local prio
    prio=$(match_list_priority_line || true)
    if [[ -n $prio ]]; then
      IFS='|' read -r class initial win_mon win_addr focused _ <<<"$prio"
      adopt_follow_subject "$win_mon" "$class" "$win_addr"
      return 0
    fi
  fi

  if [[ $phase == live ]]; then
    if buffer_running; then
      enter_linger
    else
      go_armed
    fi
    return 0
  fi

  if [[ $phase == linger ]]; then
    local now
    now=$(now_epoch)
    if [[ $linger_until =~ ^[0-9]+$ ]] && (( now >= linger_until )); then
      go_armed
    fi
    return 0
  fi
}

cmd_pin_tick() {
  load_config
  [[ $CONFIG_MODE == pin ]] || return 0
  follow_session_active || return 0
  WINDOWS_SNAPSHOT=1
  PARSE_WINDOWS_CACHE_SET=0

  local phase monitor linger_until
  phase=$(activity_value phase)
  monitor=$(activity_value monitor)
  linger_until=$(activity_value linger_until)

  if [[ -z $CONFIG_PIN_ADDRESS ]]; then
    if [[ $phase == live || $phase == linger ]]; then
      if buffer_running && [[ $phase == live ]]; then
        enter_linger
      elif [[ $phase == linger ]]; then
        local now
        now=$(now_epoch)
        if [[ $linger_until =~ ^[0-9]+$ ]] && (( now >= linger_until )); then
          go_armed
        fi
      fi
    fi
    return 0
  fi

  local line class win_mon win_addr
  line=$(window_line_by_address "$CONFIG_PIN_ADDRESS" || true)
  if [[ -n $line ]]; then
    IFS='|' read -r class _ win_mon win_addr _ <<<"$line"
    if [[ $phase == linger && $win_mon == "$monitor" ]]; then
      write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(activity_value started)" live "$class" "$win_addr" "-" "$(window_crop_spec "$win_addr" "$class" "$win_mon")"
      return 0
    fi
    if [[ $phase == live || $phase == linger ]]; then
      if [[ $win_mon == "$monitor" ]]; then
        write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(activity_value started)" live "$class" "$win_addr" "-" "$(window_crop_spec "$win_addr" "$class" "$win_mon")"
        return 0
      fi
      go_live_on "$win_mon" "$class" "$win_addr"
      return 0
    fi
    go_live_on "$win_mon" "$class" "$win_addr"
    return 0
  fi

  if [[ $phase == live ]]; then
    if buffer_running; then
      enter_linger
    else
      go_armed
    fi
    return 0
  fi

  if [[ $phase == linger ]]; then
    local now
    now=$(now_epoch)
    if [[ $linger_until =~ ^[0-9]+$ ]] && (( now >= linger_until )); then
      go_armed
    fi
  fi
}

cmd_tick() {
  cmd_follow_tick
  cmd_pin_tick
}

cmd_start() {
  load_config
  apply_start_flags "$@"
  if [[ $CONFIG_MODE == pin ]]; then
    CONFIG_CAPTURE_EXTENT=window
  fi
  write_config
  if [[ $CONFIG_MODE == follow || $CONFIG_MODE == pin ]]; then
    if ! follow_session_active; then
      write_activity false "" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "" armed "-" "-" "-"
    fi
    cmd_tick
    cmd_status --json
    return 0
  fi
  local monitor
  if [[ $CONFIG_MODE == region ]]; then
    [[ -n $CONFIG_REGION ]] || die "Region Mode needs a rectangle. Pick a region first."
    monitor=$(region_host_monitor "$CONFIG_REGION")
  else
    monitor=$(resolve_monitor)
  fi
  if buffer_running; then
    if live_capture_differs "$monitor"; then
      split_and_restart
    fi
    cmd_status
    return 0
  fi
  launch_recorder
  cmd_status
}

cmd_stop() {
  stop_recorder
  discard_all_segments
  write_activity false "$(activity_value monitor)" "$(activity_value seconds)" "$(activity_value audio)" "$(activity_value last_clip)" "" off "-" "-" "-" "-"
}

cmd_save() {
  load_config
  buffer_running || die "replay buffer is not running"
  local seconds="${1:-}"
  if [[ -n $seconds ]]; then
    [[ $seconds =~ ^[0-9]+$ ]] || die "seconds must be a positive integer"
    (( seconds > 0 )) || die "seconds must be a positive integer"
  fi
  local live dest dir stamp window job_index="" job_dir crop audio canvas
  window="${seconds:-$CONFIG_SECONDS}"
  mkdir -p "$STATE_DIR" "$SAVE_JOBS_DIR"
  if [[ -L $STATE_DIR/save.lock ]]; then
    die "save lock is a symbolic link"
  fi
  exec 9>>"$STATE_DIR/save.lock"
  flock 9
  discard_old_segments "$window"
  live=$(save_replay_path "$seconds" restart) || die "save-replay did not return a file path"
  [[ -e $live ]] || die "save-replay did not create a file"
  if [[ -r $SEGMENT_INDEX ]]; then
    job_index="$SEGMENT_DIR/.save-index.$$"
    mv -f "$SEGMENT_INDEX" "$job_index"
  fi
  write_activity true "$(activity_value monitor)" "$(activity_value seconds)" "$(activity_value audio)" "$(activity_value last_clip)" "$(now_epoch)"
  dir=$(output_dir)
  mkdir -p "$dir"
  stamp=$(now_epoch)
  dest=$(unique_clip_path "$dir" "$stamp")
  job_dir="$SAVE_JOBS_DIR/${stamp}.$$.$RANDOM"
  mkdir -p "$job_dir"
  printf '%s\n' "$dest" > "$job_dir/dest"
  printf '%s\n' "$live" > "$job_dir/live"
  printf '%s\n' "$window" > "$job_dir/window"
  printf '%s\n' "$job_index" > "$job_dir/index"
  crop=$(live_crop_spec)
  audio=$(activity_value audio)
  [[ -n $audio ]] || audio=$CONFIG_AUDIO
  printf '%s\n' "$crop" > "$job_dir/crop"
  printf '%s\n' "$audio" > "$job_dir/audio"
  canvas=$(clip_resolution_size)
  printf '%s\n' "$canvas" > "$job_dir/canvas"
  printf '%s\n' "$CONFIG_CLIP_SCALE" > "$job_dir/scale"
  flock -u 9
  if [[ ${STATE_LOCK_FD:-} =~ ^[0-9]+$ ]]; then
    eval 'bash "${BASH_SOURCE[0]}" finish-save "$job_dir" >/dev/null 2>>"$LOG_FILE" '"${STATE_LOCK_FD}"'<&- &'
  else
    bash "${BASH_SOURCE[0]}" finish-save "$job_dir" >/dev/null 2>>"$LOG_FILE" &
  fi
  printf '%s\n' "$!" > "$job_dir/pid"
  disown $! 2>/dev/null || true
  printf '%s\n' "$dest"
}

cmd_finish_save() {
  local job_dir="${1:-}"
  [[ -n $job_dir && $job_dir == /* && $job_dir != *..* ]] || die "save job is missing"
  [[ $job_dir == "$SAVE_JOBS_DIR/"* ]] || die "save job is missing"
  [[ -d $job_dir ]] || die "save job is missing"
  load_config
  local dest live window index crop audio canvas scale path joined=0
  dest=$(<"$job_dir/dest")
  live=$(<"$job_dir/live")
  window=$(<"$job_dir/window")
  index=$(<"$job_dir/index")
  crop=$(<"$job_dir/crop")
  audio=$(<"$job_dir/audio")
  canvas=""
  scale=""
  [[ -r $job_dir/canvas ]] && canvas=$(<"$job_dir/canvas")
  [[ -r $job_dir/scale ]] && scale=$(<"$job_dir/scale")
  [[ -n $dest && -n $live ]] || die "save job is incomplete"
  trap '[[ $joined == 1 ]] || rm -f "$dest"' EXIT
  path=$(join_clip "$live" "$dest" "$window" "$index" "$crop" "$audio" "$canvas" "$scale")
  joined=1
  consume_segment_job "$index"
  rm -f "$live"
  acquire_state_lock
  write_activity "$(activity_value running)" "$(activity_value monitor)" "$(activity_value seconds)" "$(activity_value audio)" "$path"
  notify "Replay saved" "$path"
  rm -rf "$job_dir"
}

print_status_json() {
  local running="$1"
  printf '{'
  printf '"running":%s,' "$(json_bool "$running")"
  printf '"monitor":%s,' "$(json_string_or_null "${2:-}")"
  printf '"configuredMonitor":%s,' "$(json_string "$CONFIG_MONITOR")"
  printf '"seconds":%s,' "${3:-$CONFIG_SECONDS}"
  printf '"audio":%s,' "$(json_string "${4:-$CONFIG_AUDIO}")"
  printf '"pid":%s,' "$(json_string_or_null "${5:-}")"
  printf '"ipc":%s,' "$(json_string "$IPC")"
  printf '"outputDir":%s,' "$(json_string "$(output_dir)")"
  printf '"lastClip":%s,' "$(json_string_or_null "${6:-}")"
  printf '"saving":%s,' "$(saving_count)"
  local phase armed linger
  phase=$(activity_value phase)
  [[ -n $phase ]] || phase=$([[ $running == true ]] && echo live || echo off)
  armed=false
  linger=false
  [[ $phase == armed ]] && armed=true
  [[ $phase == linger ]] && linger=true
  printf '"phase":%s,' "$(json_string "$phase")"
  printf '"armed":%s,' "$(json_bool "$armed")"
  printf '"linger":%s,' "$(json_bool "$linger")"
  printf '"subject":%s,' "$(json_string_or_null "$(activity_value subject_class)")"
  printf '"region":%s,' "$(json_string "$CONFIG_REGION")"
  print_settings_fields
  printf '}\n'
}

cmd_status() {
  load_config
  reap_save_jobs
  if [[ $CONFIG_MODE == follow || $CONFIG_MODE == pin ]]; then
    cmd_tick
  fi
  local json="false" pid="" running="false"
  if [[ ${1:-} == --json ]]; then
    json="true"
  fi
  pid=$(read_pid 2>/dev/null || true)
  if buffer_running; then
    running="true"
  else
    pid=""
  fi
  local monitor seconds audio last_clip
  monitor=$(activity_value monitor)
  seconds=$(activity_value seconds)
  audio=$(activity_value audio)
  last_clip=$(activity_value last_clip)
  [[ -n $seconds ]] || seconds=$CONFIG_SECONDS
  [[ -n $audio ]] || audio=$CONFIG_AUDIO
  if [[ $running == true && -z $monitor ]]; then
    monitor=$(resolve_monitor)
  fi

  if [[ $json == true ]]; then
    print_status_json "$running" "$monitor" "$seconds" "$audio" "$pid" "$last_clip"
    return
  fi
  local saving
  saving=$(saving_count)
  if [[ $running == true ]]; then
    printf 'running %s last %ss audio=%s' "$monitor" "$seconds" "$audio"
  else
    printf 'stopped monitor=%s last %ss audio=%s' "${CONFIG_MONITOR:-focused}" "$CONFIG_SECONDS" "$CONFIG_AUDIO"
  fi
  if (( saving > 0 )); then
    printf ' saving=%s' "$saving"
  fi
  printf '\n'
}

cmd_monitors() {
  local json="false"
  if [[ ${1:-} == --json ]]; then
    json="true"
  fi
  local focused
  focused=$(focused_monitor || true)
  if [[ $json == true ]]; then
    local first="true" line name size
    printf '['
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      name=${line%%|*}
      size=${line#*|}
      size=${size%%|*}
      [[ $first == true ]] || printf ','
      first="false"
      printf '{"name":%s,"size":%s,"focused":%s}' \
        "$(json_string "$name")" \
        "$(json_string "$size")" \
        "$(json_bool "$([[ $name == "$focused" ]] && echo true || echo false)")"
    done < <(list_monitor_lines)
    printf ']\n'
    return
  fi
  local line name size mark
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    name=${line%%|*}
    size=${line#*|}
    size=${size%%|*}
    mark=" "
    [[ $name == "$focused" ]] && mark="*"
    printf '%s %s %s\n' "$mark" "$name" "$size"
  done < <(list_monitor_lines)
}

cmd_windows() {
  load_config
  local clients monitors names
  clients=$(windows_json)
  monitors=$(monitors_json)
  names=$(list_monitor_names)
  SHADOWPLAY_MONITORS_JSON="$monitors" SHADOWPLAY_MONITOR_NAMES="$names" "$PYTHON_BIN" -I -c '
import json, os, sys
def load(raw):
    try:
        data = json.loads(raw or "[]")
    except Exception:
        return []
    if isinstance(data, dict):
        return [data]
    return data if isinstance(data, list) else []
clients = load(sys.stdin.read())
monitors = load(os.environ.get("SHADOWPLAY_MONITORS_JSON", "[]"))
id_to_name = {}
gsr_names = [n for n in os.environ.get("SHADOWPLAY_MONITOR_NAMES", "").splitlines() if n]
for i, name in enumerate(gsr_names):
    id_to_name[str(i)] = name
    id_to_name[name] = name
for mon in monitors:
    if not isinstance(mon, dict):
        continue
    name = str(mon.get("name") or "")
    mid = mon.get("id")
    if name:
        id_to_name[name] = name
    if name and mid is not None:
        id_to_name[str(mid)] = name
focus = os.environ.get("SHADOWPLAY_FOCUSED_ADDRESS", "")
rows = []
best = None
for item in clients:
    if not isinstance(item, dict):
        continue
    klass = str(item.get("class") or item.get("initialClass") or "")
    initial = str(item.get("initialClass") or klass)
    title = str(item.get("title") or item.get("initialTitle") or "")
    raw_mon = item.get("monitor")
    monitor = ""
    if raw_mon is not None and raw_mon != "":
        key = str(raw_mon)
        monitor = id_to_name.get(key, key if not str(raw_mon).isdigit() else "")
    address = str(item.get("address") or "")
    hist = item.get("focusHistoryID")
    focused = item.get("focused") is True or item.get("active") is True
    if hist == 0:
        focused = True
    if focus and address == focus:
        focused = True
    hist_n = hist if isinstance(hist, int) else 10**9
    rows.append({"class": klass, "initialClass": initial, "title": title, "monitor": monitor, "address": address, "focused": focused, "_hist": hist_n})
if rows and not any(r["focused"] for r in rows):
    winner = min(rows, key=lambda r: r["_hist"])
    for r in rows:
        r["focused"] = r is winner
out = []
for r in rows:
    r.pop("_hist", None)
    out.append(r)
print(json.dumps(out))
' <<<"$clients"
}

