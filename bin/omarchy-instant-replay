  load_config
  if [[ ${1:-} == --json ]]; then
    printf '{'
    printf '"monitor":%s,' "$(json_string "$CONFIG_MONITOR")"
    printf '"seconds":%s,' "$CONFIG_SECONDS"
    printf '"audio":%s,' "$(json_string "$CONFIG_AUDIO")"
    printf '"outputDir":%s,' "$(json_string "$CONFIG_OUTPUT_DIR")"
    printf '"region":%s,' "$(json_string "$CONFIG_REGION")"
    print_settings_fields
    printf '}\n'
    return
  fi
  printf 'monitor=%s\n' "$CONFIG_MONITOR"
  printf 'seconds=%s\n' "$CONFIG_SECONDS"
  printf 'audio=%s\n' "$CONFIG_AUDIO"
  printf 'mode=%s\n' "$CONFIG_MODE"
  printf 'filter=%s\n' "$CONFIG_FILTER"
  printf 'matchList=%s\n' "${CONFIG_MATCH_LIST//$'\n'/,}"
  printf 'captureExtent=%s\n' "$CONFIG_CAPTURE_EXTENT"
  printf 'clipResolution=%s\n' "$CONFIG_CLIP_RESOLUTION"
  printf 'clipScale=%s\n' "$CONFIG_CLIP_SCALE"
  printf 'outputDir=%s\n' "$CONFIG_OUTPUT_DIR"
  printf 'region=%s\n' "$CONFIG_REGION"
  printf 'pinAddress=%s\n' "$CONFIG_PIN_ADDRESS"
}

cmd_settings_set() {
  load_config
  local prev_mode="$CONFIG_MODE"
  local key="${1:-}" value="${2:-}"
  [[ -n $key ]] || die_usage "settings set requires a key"
  case "$key" in
  monitor)
    CONFIG_MONITOR="$value"
    ;;
  seconds)
    [[ $value =~ ^[0-9]+$ ]] || die "seconds must be an integer"
    CONFIG_SECONDS="$value"
    clamp_seconds
    [[ $CONFIG_SECONDS == "$value" ]] || die "seconds must be between $MIN_SECONDS and $MAX_SECONDS"
    ;;
  audio)
    [[ $value == none || $value == desktop || $value == both || $value == window || $value == window-mic ]] || die "audio must be none, desktop, both, window, or window-mic"
    CONFIG_AUDIO="$value"
    ;;
  mode)
    [[ $value == monitor || $value == follow || $value == pin || $value == region ]] || die "mode must be monitor, follow, pin, or region"
    CONFIG_MODE="$value"
    if [[ $value == follow && $prev_mode != follow ]]; then
      CONFIG_CAPTURE_EXTENT=window
    fi
    ;;
  filter)
    [[ $value == all || $value == allowlist || $value == denylist ]] || die "filter must be all, allowlist, or denylist"
    CONFIG_FILTER="$value"
    ;;
  matchList)
    CONFIG_MATCH_LIST="$(csv_to_lines "$value")"
    ;;
  captureExtent)
    [[ $value == monitor || $value == window ]] || die "captureExtent must be monitor or window"
    if [[ $CONFIG_MODE == follow || $CONFIG_MODE == pin ]]; then
      CONFIG_CAPTURE_EXTENT=window
    else
      CONFIG_CAPTURE_EXTENT="$value"
    fi
    ;;
  codec)
    [[ -n $value ]] || die "codec must not be empty"
    config_value_safe "$value" || die "codec value contains a newline"
    CONFIG_CODEC=$(normalize_codec "$value")
    [[ $CONFIG_CODEC == "$value" ]] || die "codec must be auto, h264, hevc, av1, vp8, or vp9"
    ;;
  fps)
    [[ $value =~ ^[0-9]+$ ]] || die "fps must be an integer"
    CONFIG_FPS="$value"
    clamp_fps
    [[ $CONFIG_FPS == "$value" ]] || die "fps must be between $MIN_FPS and $MAX_FPS"
    ;;
  quality)
    [[ $value =~ ^[0-9]+$ ]] || die "quality must be an integer"
    CONFIG_QUALITY="$value"
    clamp_quality
    [[ $CONFIG_QUALITY == "$value" ]] || die "quality must be between $MIN_QUALITY and $MAX_QUALITY"
    ;;
  cursor)
    [[ $value == true || $value == false ]] || die "cursor must be true or false"
    CONFIG_CURSOR="$value"
    ;;
  framerateMode)
    [[ $value == cfr || $value == vfr ]] || die "framerateMode must be cfr or vfr"
    CONFIG_FRAMERATE_MODE="$value"
    ;;
  bitrateMode)
    [[ $value == cbr || $value == vbr ]] || die "bitrateMode must be cbr or vbr"
    CONFIG_BITRATE_MODE="$value"
    ;;
  clipResolution)
    CONFIG_CLIP_RESOLUTION="$(normalize_clip_resolution "$value")"
    ;;
  clipScale)
    CONFIG_CLIP_SCALE="$(normalize_clip_scale "$value")"
    ;;
  outputDir)
    config_value_safe "$value" || die "outputDir value contains a newline"
    if [[ -n $value && $value != /* && $value != "~" && $value != "~/"* ]]; then
      die "outputDir must be an absolute path"
    fi
    CONFIG_OUTPUT_DIR="$value"
    ;;
  region)
    config_value_safe "$value" || die "region value contains a newline"
    if [[ -n $value ]]; then
      value=$(normalize_region_spec "$value") || die "region must be WxH+X+Y or X,Y WxH"
      validate_region "$value"
    fi
    CONFIG_REGION="$value"
    ;;
  blacklist)
    CONFIG_BLACKLIST="${value//,/
}"
    BLACKLIST_PRESENT=true
    ;;
  pinAddress)
    config_value_safe "$value" || die "pinAddress value contains a newline"
    CONFIG_PIN_ADDRESS="$value"
    ;;
  *)
    die "unknown setting: $key"
    ;;
  esac
  if [[ $CONFIG_MODE == pin ]]; then
    CONFIG_CAPTURE_EXTENT=window
  fi
  write_config
  if [[ $key == mode && $prev_mode != "$CONFIG_MODE" ]]; then
    if buffer_running; then
      flush_segment
      stop_recorder
    fi
    if [[ $CONFIG_MODE == follow || $CONFIG_MODE == pin ]]; then
      write_activity false "$(activity_value monitor)" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "" armed "-" "-" "-"
      cmd_tick
    elif buffer_running || [[ $(activity_value phase) == live || $(activity_value phase) == linger ]]; then
      launch_recorder
    fi
  elif [[ $key == matchList || $key == blacklist || $key == filter || $key == clipResolution || $key == clipScale || $key == captureExtent || $key == outputDir ]]; then
    if [[ $CONFIG_MODE == follow ]] && follow_session_active; then
      cmd_follow_tick
    fi
  elif [[ $key == pinAddress ]]; then
    if [[ $CONFIG_MODE == pin ]] && follow_session_active; then
      cmd_pin_tick
    fi
  elif [[ $CONFIG_MODE == follow ]] && follow_session_active; then
    local monitor
    monitor=$(activity_value monitor)
    if [[ $key != matchList && $key != filter ]] && buffer_running && [[ -n $monitor ]] && live_capture_differs "$monitor"; then
      local saved="$CONFIG_MONITOR"
      CONFIG_MONITOR="$monitor"
      split_and_restart
      CONFIG_MONITOR="$saved"
      write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(now_epoch)" "$(activity_value phase)" "$(activity_value subject_class)" "$(activity_value subject_address)" "$(activity_value linger_until)" "$(window_crop_spec "$(activity_value subject_address)" "$(activity_value subject_class)" "$monitor")"
    fi
    cmd_follow_tick
  elif [[ $CONFIG_MODE == pin ]] && follow_session_active; then
    local monitor
    monitor=$(activity_value monitor)
    if buffer_running && [[ -n $monitor ]] && live_capture_differs "$monitor"; then
      local saved="$CONFIG_MONITOR"
      CONFIG_MONITOR="$monitor"
      split_and_restart
      CONFIG_MONITOR="$saved"
      write_activity true "$monitor" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(now_epoch)" "$(activity_value phase)" "$(activity_value subject_class)" "$(activity_value subject_address)" "$(activity_value linger_until)"
    fi
    cmd_pin_tick
  elif buffer_running; then
    local monitor
    if [[ $CONFIG_MODE == region ]]; then
      [[ -n $CONFIG_REGION ]] || die "Region Mode needs a rectangle. Pick a region first."
      monitor=$(region_host_monitor "$CONFIG_REGION")
    else
      monitor=$(resolve_monitor)
    fi
    if live_capture_differs "$monitor"; then
      split_and_restart
    fi
  fi
  cmd_settings_show --json
}

cmd_pick_window() {
  load_config
  local addr
  addr=$(pick_window_address)
  CONFIG_PIN_ADDRESS="$addr"
  CONFIG_MODE="pin"
  CONFIG_CAPTURE_EXTENT=window
  write_config
  if follow_session_active || buffer_running; then
    if ! follow_session_active; then
      write_activity true "$(activity_value monitor)" "$CONFIG_SECONDS" "$CONFIG_AUDIO" "$(activity_value last_clip)" "$(activity_value started)" live "-" "-" "-"
    fi
    cmd_pin_tick
  fi
  cmd_settings_show --json
}

cmd_pick_blacklist_window() {
  load_config
  local addr line class
  addr=$(pick_window_address)
  line=$(window_line_by_address "$addr") || die "could not resolve the picked window"
  IFS='|' read -r class _ <<<"$line"
  [[ -n $class ]] || die "could not resolve the picked window"
  append_blacklist_class "$class"
  write_config
  if [[ $CONFIG_MODE == follow ]] && follow_session_active; then
    cmd_follow_tick
  fi
  cmd_settings_show --json
}

cmd_pick_match_window() {
  load_config
  local addr line class
  addr=$(pick_window_address)
  line=$(window_line_by_address "$addr") || die "could not resolve the picked window"
  IFS='|' read -r class _ <<<"$line"
  [[ -n $class ]] || die "could not resolve the picked window"
  append_match_list_class "$class"
  write_config
  if [[ $CONFIG_MODE == follow ]] && follow_session_active; then
    cmd_follow_tick
  fi
  cmd_settings_show --json
}

cmd_pick_region() {
  load_config
  local spec
  spec=$(pick_region_spec)
  validate_region "$spec"
  CONFIG_REGION="$spec"
  CONFIG_MODE="region"
  write_config
  if buffer_running; then
    local monitor
    monitor=$(region_host_monitor "$CONFIG_REGION")
    if live_capture_differs "$monitor"; then
      split_and_restart
    fi
  fi
  cmd_settings_show --json
}

cmd_doctor() {
  local ok="true"
  printf 'gpu-screen-recorder: '
  if command -v "$GSR_BIN" >/dev/null 2>&1; then
    printf 'ok (%s)\n' "$("$GSR_BIN" --version 2>/dev/null | head -n 1 || echo present)"
  else
    printf 'missing\n'
    ok="false"
  fi
  printf 'gsr-cli: '
  if command -v "$GSR_CLI_BIN" >/dev/null 2>&1; then
    printf 'ok\n'
  else
    printf 'missing\n'
    ok="false"
  fi
  printf 'monitors:\n'
  cmd_monitors
  printf 'ipc: %s\n' "$IPC"
  printf 'buffer: '
  if buffer_running; then
    printf 'running\n'
  else
    printf 'stopped\n'
  fi
  printf 'session recording: '
  if capture_device_busy; then
    printf 'running (capture device busy)\n'
  else
    printf 'not detected\n'
  fi
  [[ $ok == true ]]
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
  start|stop|save|status|tick|settings|pick-region|pick-window|pick-blacklist-window|pick-match-window)
    acquire_state_lock
    ;;
  esac
  case "$cmd" in
  ""|-h|--help) usage ;;
  --version|-V) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
  start) shift; cmd_start "$@" ;;
  stop) cmd_stop ;;
  save) shift; cmd_save "${1:-}" ;;
  finish-save) shift; cmd_finish_save "${1:-}" ;;
  status) shift; cmd_status "${1:-}" ;;
  monitors) shift; cmd_monitors "${1:-}" ;;
  windows) shift; cmd_windows "${1:-}" ;;
  settings)
    shift
    case "${1:-}" in
    show) shift; cmd_settings_show "${1:-}" ;;
    set) shift; cmd_settings_set "${1:-}" "${2:-}" ;;
    *) die_usage "settings expects show or set" ;;
    esac
    ;;
  tick) cmd_tick; cmd_status --json ;;
  pick-region) cmd_pick_region ;;
  pick-window) cmd_pick_window ;;
  pick-blacklist-window) cmd_pick_blacklist_window ;;
  pick-match-window) cmd_pick_match_window ;;
  doctor) cmd_doctor ;;
  *) die_usage "unknown command: $cmd" ;;
  esac
}

main "$@"
