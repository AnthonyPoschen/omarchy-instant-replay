#!/usr/bin/env bash
set -euo pipefail

PROGRAM="omarchy-shadowplay"
PROCESS_NAME="omarchy-shadowplay-gsr"
VERSION="0.1.0"

HOME="${HOME:?HOME is not set}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CONFIG_DIR="$CONFIG_HOME/omarchy-shadowplay"
STATE_DIR="$STATE_HOME/omarchy-shadowplay"
CONFIG_FILE="$CONFIG_DIR/config"
PID_FILE="$STATE_DIR/recorder.pid"
ACTIVITY_FILE="$STATE_DIR/activity"
LOG_FILE="$STATE_DIR/gsr.log"
SEGMENT_DIR="$STATE_DIR/segments"
SEGMENT_INDEX="$SEGMENT_DIR/index"

GSR_BIN="${SHADOWPLAY_GSR_BIN:-gpu-screen-recorder}"
GSR_CLI_BIN="${SHADOWPLAY_GSR_CLI_BIN:-gsr-cli}"
FFMPEG_BIN="${SHADOWPLAY_FFMPEG_BIN:-ffmpeg}"
FOCUSED_MONITOR_BIN="${SHADOWPLAY_FOCUSED_MONITOR_BIN:-omarchy-hyprland-monitor-focused}"

DEFAULT_SECONDS=60
DEFAULT_AUDIO="desktop"
DEFAULT_MODE="monitor"
DEFAULT_FILTER="all"
DEFAULT_CAPTURE_EXTENT="monitor"
DEFAULT_CODEC="auto"
DEFAULT_FPS=60
DEFAULT_QUALITY=40000
DEFAULT_CURSOR="true"
DEFAULT_FRAMERATE_MODE="cfr"
DEFAULT_BITRATE_MODE="cbr"
MIN_SECONDS=15
MAX_SECONDS=600
MIN_FPS=1
MAX_FPS=240

CONFIG_MONITOR=""
CONFIG_SECONDS="$DEFAULT_SECONDS"
CONFIG_AUDIO="$DEFAULT_AUDIO"
CONFIG_MODE="$DEFAULT_MODE"
CONFIG_FILTER="$DEFAULT_FILTER"
CONFIG_CAPTURE_EXTENT="$DEFAULT_CAPTURE_EXTENT"
CONFIG_CODEC="$DEFAULT_CODEC"
CONFIG_FPS="$DEFAULT_FPS"
CONFIG_QUALITY="$DEFAULT_QUALITY"
CONFIG_CURSOR="$DEFAULT_CURSOR"
CONFIG_FRAMERATE_MODE="$DEFAULT_FRAMERATE_MODE"
CONFIG_BITRATE_MODE="$DEFAULT_BITRATE_MODE"
CONFIG_MATCH_LIST=""
CONFIG_BLACKLIST=""

runtime_base() {
  local candidate="${XDG_RUNTIME_DIR:-}"
  if [[ -n $candidate && -d $candidate && -w $candidate && -O $candidate ]]; then
    printf '%s\n' "$candidate"
    return
  fi

  candidate="${TMPDIR:-/tmp}/omarchy-shadowplay-runtime-$(id -u)"
  if [[ -L $candidate ]]; then
    die "unsafe runtime path is a symbolic link: $candidate"
  fi
  if [[ -e $candidate && ! -d $candidate ]]; then
    die "unsafe runtime path is not a directory: $candidate"
  fi
  if [[ -d $candidate && ! -O $candidate ]]; then
    die "unsafe runtime path is owned by another user: $candidate"
  fi
  (umask 077; mkdir -p "$candidate")
  chmod 700 "$candidate"
  printf '%s\n' "$candidate"
}

RUNTIME_BASE="$(runtime_base)"
RUNTIME_DIR="$RUNTIME_BASE/omarchy-shadowplay"
IPC="$RUNTIME_DIR/gsr.sock"
GSR_OUTPUT_DIR="$RUNTIME_DIR/gsr-output"
(umask 077; mkdir -p "$RUNTIME_DIR" "$STATE_DIR" "$CONFIG_DIR" "$SEGMENT_DIR" "$GSR_OUTPUT_DIR")
chmod 700 "$RUNTIME_DIR" "$STATE_DIR" "$CONFIG_DIR" "$SEGMENT_DIR" "$GSR_OUTPUT_DIR"

usage() {
  cat <<USAGE
Usage:
  $PROGRAM start
  $PROGRAM stop
  $PROGRAM save [seconds]
  $PROGRAM status [--json]
  $PROGRAM monitors [--json]
  $PROGRAM settings show [--json]
  $PROGRAM settings set monitor <name|>
  $PROGRAM settings set seconds <15-600>
  $PROGRAM settings set audio <none|desktop|both>
  $PROGRAM settings set mode <monitor|follow|pin|region>
  $PROGRAM settings set filter <all|allowlist|denylist>
  $PROGRAM settings set captureExtent <monitor|window>
  $PROGRAM settings set codec <name>
  $PROGRAM settings set fps <1-240>
  $PROGRAM settings set quality <integer>
  $PROGRAM settings set cursor <true|false>
  $PROGRAM settings set framerateMode <cfr|vfr>
  $PROGRAM settings set bitrateMode <cbr|vbr>
  $PROGRAM doctor
  $PROGRAM --help
  $PROGRAM --version

Start a GPU Screen Recorder instant-replay buffer on one monitor, then save
the last N seconds without stopping the buffer.

An empty monitor setting captures whichever monitor is focused when start runs.
Changing the Buffer Target while Live flushes a Segment and restarts capture.
Save joins overlapping Segments with the live buffer into one Clip.

This process is launched as $PROCESS_NAME so Omarchy's stock screen recorder
does not treat it as a session recording. Only one KMS capture can run at a
time, so stock omarchy screenrecord may fail while the buffer is active.
USAGE
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit 1
}

die_usage() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  printf "Try '%s --help' for usage.\n" "$PROGRAM" >&2
  exit 2
}

json_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

json_string_or_null() {
  if [[ -n ${1:-} ]]; then
    json_string "$1"
  else
    printf 'null'
  fi
}

json_bool() {
  if [[ $1 == true ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

json_string_array() {
  local first="true" item
  printf '['
  if [[ -n ${1:-} ]]; then
    while IFS= read -r item; do
      [[ -n $item ]] || continue
      [[ $first == true ]] || printf ','
      first="false"
      json_string "$item"
    done <<<"$1"
  fi
  printf ']'
}

print_encoder_json() {
  printf '{'
  printf '"codec":%s,' "$(json_string "$CONFIG_CODEC")"
  printf '"fps":%s,' "$CONFIG_FPS"
  printf '"quality":%s,' "$CONFIG_QUALITY"
  printf '"cursor":%s,' "$(json_bool "$CONFIG_CURSOR")"
  printf '"framerateMode":%s,' "$(json_string "$CONFIG_FRAMERATE_MODE")"
  printf '"bitrateMode":%s' "$(json_string "$CONFIG_BITRATE_MODE")"
  printf '}'
}

print_settings_fields() {
  printf '"mode":%s,' "$(json_string "$CONFIG_MODE")"
  printf '"filter":%s,' "$(json_string "$CONFIG_FILTER")"
  printf '"captureExtent":%s,' "$(json_string "$CONFIG_CAPTURE_EXTENT")"
  printf '"matchList":%s,' "$(json_string_array "$CONFIG_MATCH_LIST")"
  printf '"blacklist":%s,' "$(json_string_array "$CONFIG_BLACKLIST")"
  printf '"encoder":%s' "$(print_encoder_json)"
}

reset_config_defaults() {
  CONFIG_MONITOR=""
  CONFIG_SECONDS="$DEFAULT_SECONDS"
  CONFIG_AUDIO="$DEFAULT_AUDIO"
  CONFIG_MODE="$DEFAULT_MODE"
  CONFIG_FILTER="$DEFAULT_FILTER"
  CONFIG_CAPTURE_EXTENT="$DEFAULT_CAPTURE_EXTENT"
  CONFIG_CODEC="$DEFAULT_CODEC"
  CONFIG_FPS="$DEFAULT_FPS"
  CONFIG_QUALITY="$DEFAULT_QUALITY"
  CONFIG_CURSOR="$DEFAULT_CURSOR"
  CONFIG_FRAMERATE_MODE="$DEFAULT_FRAMERATE_MODE"
  CONFIG_BITRATE_MODE="$DEFAULT_BITRATE_MODE"
  CONFIG_MATCH_LIST=""
  CONFIG_BLACKLIST=""
}

config_value_safe() {
  [[ $1 != *$'\n'* && $1 != *$'\r'* ]]
}

now_epoch() {
  printf '%s\n' "${SHADOWPLAY_NOW:-$(date +%s)}"
}

notify() {
  local title="$1"
  local body="${2:-}"
  [[ ${SHADOWPLAY_NOTIFY:-true} == true ]] || return 0
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    if [[ -n $body ]]; then
      omarchy-notification-send "$title" "$body" || true
    else
      omarchy-notification-send "$title" || true
    fi
    return
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$title" "$body" || true
  fi
}

load_config() {
  local key value
  reset_config_defaults

  [[ -r $CONFIG_FILE ]] || return 0
  while IFS='=' read -r key value || [[ -n ${key:-} ]]; do
    [[ -n ${key:-} && $key != \#* ]] || continue
    case "$key" in
    monitor) CONFIG_MONITOR="$value" ;;
    seconds)
      [[ $value =~ ^[0-9]+$ ]] && CONFIG_SECONDS="$value"
      ;;
    audio)
      [[ $value == none || $value == desktop || $value == both ]] && CONFIG_AUDIO="$value"
      ;;
    mode)
      [[ $value == monitor || $value == follow || $value == pin || $value == region ]] && CONFIG_MODE="$value"
      ;;
    filter)
      [[ $value == all || $value == allowlist || $value == denylist ]] && CONFIG_FILTER="$value"
      ;;
    captureExtent)
      [[ $value == monitor || $value == window ]] && CONFIG_CAPTURE_EXTENT="$value"
      ;;
    codec)
      config_value_safe "$value" && [[ -n $value ]] && CONFIG_CODEC="$value"
      ;;
    fps)
      [[ $value =~ ^[0-9]+$ ]] && CONFIG_FPS="$value"
      ;;
    quality)
      [[ $value =~ ^[0-9]+$ ]] && CONFIG_QUALITY="$value"
      ;;
    cursor)
      [[ $value == true || $value == false ]] && CONFIG_CURSOR="$value"
      ;;
    framerateMode)
      [[ $value == cfr || $value == vfr ]] && CONFIG_FRAMERATE_MODE="$value"
      ;;
    bitrateMode)
      [[ $value == cbr || $value == vbr ]] && CONFIG_BITRATE_MODE="$value"
      ;;
    matchList)
      CONFIG_MATCH_LIST="${value//,/
}"
      ;;
    blacklist)
      CONFIG_BLACKLIST="${value//,/
}"
      ;;
    esac
  done < "$CONFIG_FILE"
  clamp_seconds
  clamp_fps
}

clamp_seconds() {
  if (( CONFIG_SECONDS < MIN_SECONDS )); then
    CONFIG_SECONDS=$MIN_SECONDS
  elif (( CONFIG_SECONDS > MAX_SECONDS )); then
    CONFIG_SECONDS=$MAX_SECONDS
  fi
}

clamp_fps() {
  if (( CONFIG_FPS < MIN_FPS )); then
    CONFIG_FPS=$MIN_FPS
  elif (( CONFIG_FPS > MAX_FPS )); then
    CONFIG_FPS=$MAX_FPS
  fi
}

write_config() {
  config_value_safe "$CONFIG_MONITOR" || die "monitor value contains a newline"
  config_value_safe "$CONFIG_CODEC" || die "codec value contains a newline"
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR" 2>/dev/null || true
  local tmp="$CONFIG_DIR/.config.$$"
  local match_csv blacklist_csv
  match_csv=${CONFIG_MATCH_LIST//$'\n'/,}
  blacklist_csv=${CONFIG_BLACKLIST//$'\n'/,}
  (umask 077
    {
      printf '# omarchy-shadowplay configuration v1\n'
      printf 'monitor=%s\n' "$CONFIG_MONITOR"
      printf 'seconds=%s\n' "$CONFIG_SECONDS"
      printf 'audio=%s\n' "$CONFIG_AUDIO"
      printf 'mode=%s\n' "$CONFIG_MODE"
      printf 'filter=%s\n' "$CONFIG_FILTER"
      printf 'captureExtent=%s\n' "$CONFIG_CAPTURE_EXTENT"
      printf 'codec=%s\n' "$CONFIG_CODEC"
      printf 'fps=%s\n' "$CONFIG_FPS"
      printf 'quality=%s\n' "$CONFIG_QUALITY"
      printf 'cursor=%s\n' "$CONFIG_CURSOR"
      printf 'framerateMode=%s\n' "$CONFIG_FRAMERATE_MODE"
      printf 'bitrateMode=%s\n' "$CONFIG_BITRATE_MODE"
      printf 'matchList=%s\n' "$match_csv"
      printf 'blacklist=%s\n' "$blacklist_csv"
    } > "$tmp"
  )
  mv -f "$tmp" "$CONFIG_FILE"
}

output_dir() {
  local dir="${SHADOWPLAY_OUTPUT_DIR:-}"
  if [[ -z $dir ]]; then
    if [[ -n ${OMARCHY_SCREENRECORD_DIR:-} ]]; then
      dir="$OMARCHY_SCREENRECORD_DIR/Replays"
    elif [[ -n ${XDG_VIDEOS_DIR:-} ]]; then
      dir="$XDG_VIDEOS_DIR/Replays"
    elif [[ -f $HOME/.config/user-dirs.dirs ]]; then
      # shellcheck disable=SC1090
      source "$HOME/.config/user-dirs.dirs"
      dir="${XDG_VIDEOS_DIR:-$HOME/Videos}/Replays"
    else
      dir="$HOME/Videos/Replays"
    fi
  fi
  printf '%s\n' "$dir"
}

pid_alive() {
  local pid="$1"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

read_pid() {
  local pid=""
  [[ -r $PID_FILE ]] || return 1
  pid=$(<"$PID_FILE")
  pid_alive "$pid" || return 1
  printf '%s\n' "$pid"
}

cli_running() {
  "$GSR_CLI_BIN" -ipc "$IPC" status >/dev/null 2>&1
}

buffer_running() {
  local pid=""
  pid=$(read_pid 2>/dev/null || true)
  if [[ -n $pid ]] && cli_running; then
    return 0
  fi
  if [[ -n $pid ]] && ! cli_running; then
    return 1
  fi
  cli_running
}

# Stock Omarchy screenrecord matches argv0 gpu-screen-recorder. Never signal those PIDs.
session_recording_pids() {
  local fake="${SHADOWPLAY_FAKE_DIR:-}"
  if [[ -n $fake ]]; then
    if [[ -r $fake/session-recording ]]; then
      cat "$fake/session-recording"
    fi
    return 0
  fi
  pgrep -f '^gpu-screen-recorder' 2>/dev/null || true
}

capture_device_busy() {
  local pids
  pids=$(session_recording_pids)
  [[ -n $pids ]]
}

die_device_busy() {
  local extra="${1:-}"
  local message="capture device is busy: a Session Recording is running"
  if [[ -n $extra ]]; then
    die "$message"$'\n'"$extra"
  fi
  die "$message"
}

list_monitor_lines() {
  "$GSR_BIN" --list-monitors 2>/dev/null || true
}

list_monitor_names() {
  list_monitor_lines | awk -F'|' 'NF { print $1 }'
}

focused_monitor() {
  if [[ -n ${SHADOWPLAY_FOCUSED_MONITOR:-} ]]; then
    printf '%s\n' "$SHADOWPLAY_FOCUSED_MONITOR"
    return
  fi
  if command -v "$FOCUSED_MONITOR_BIN" >/dev/null 2>&1; then
    "$FOCUSED_MONITOR_BIN"
    return
  fi
  list_monitor_names | head -n 1
}

resolve_monitor() {
  local requested="$CONFIG_MONITOR"
  local names name found="false"
  names=$(list_monitor_names)
  [[ -n $names ]] || die "no capture monitors were reported by $GSR_BIN"
  if [[ -z $requested ]]; then
    requested=$(focused_monitor)
    [[ -n $requested ]] || die "could not determine the focused monitor"
  fi
  while IFS= read -r name; do
    if [[ $name == "$requested" ]]; then
      found="true"
      break
    fi
  done <<<"$names"
  [[ $found == true ]] || die "monitor is not available: $requested"
  printf '%s\n' "$requested"
}

activity_value() {
  local key="$1"
  local found=""
  [[ -r $ACTIVITY_FILE ]] || return 0
  found=$(awk -F= -v k="$key" '$1==k { print substr($0, index($0, "=")+1); exit }' "$ACTIVITY_FILE")
  printf '%s' "$found"
}

write_activity() {
  local running="$1" monitor="$2" seconds="$3" audio="$4" last_clip="${5:-}"
  local tmp="$STATE_DIR/.activity.$$"
  (umask 077
    {
      printf 'running=%s\n' "$running"
      printf 'monitor=%s\n' "$monitor"
      printf 'seconds=%s\n' "$seconds"
      printf 'audio=%s\n' "$audio"
      printf 'last_clip=%s\n' "$last_clip"
    } > "$tmp"
  )
  mv -f "$tmp" "$ACTIVITY_FILE"
}

wait_until_running() {
  local pid="$1"
  local i
  for ((i = 0; i < 50; i++)); do
    if ! pid_alive "$pid"; then
      return 1
    fi
    if cli_running; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_until_stopped() {
  local pid="${1:-}"
  local i
  for ((i = 0; i < 50; i++)); do
    if [[ -n $pid ]] && pid_alive "$pid"; then
      sleep 0.1
      continue
    fi
    if cli_running; then
      sleep 0.1
      continue
    fi
    return 0
  done
  return 1
}

apply_start_flags() {
  local arg
  for arg in "$@"; do
    case "$arg" in
    --monitor=*) CONFIG_MONITOR="${arg#--monitor=}" ;;
    --seconds=*)
      local value="${arg#--seconds=}"
      [[ $value =~ ^[0-9]+$ ]] || die "seconds must be an integer"
      CONFIG_SECONDS="$value"
      clamp_seconds
      [[ $CONFIG_SECONDS == "$value" ]] || die "seconds must be between $MIN_SECONDS and $MAX_SECONDS"
      ;;
    --audio=*)
      local value="${arg#--audio=}"
      [[ $value == none || $value == desktop || $value == both ]] || die "audio must be none, desktop, or both"
      CONFIG_AUDIO="$value"
      ;;
    "") ;;
    *) die_usage "unknown start option: $arg" ;;
    esac
  done
}

log_looks_busy() {
  local log="$1"
  grep -qiE 'busy|kms.*(in use|busy)|device.*(busy|in use)|already.*(captur|record)' <<<"$log"
}

save_replay_path() {
  local seconds="${1:-}"
  local path=""
  if [[ -n $seconds ]]; then
    path=$("$GSR_CLI_BIN" -ipc "$IPC" save-replay "$seconds")
  else
    path=$("$GSR_CLI_BIN" -ipc "$IPC" save-replay)
  fi
  path=${path//$'\n'/}
  [[ -n $path ]] || die "save-replay did not return a file path"
  printf '%s\n' "$path"
}

write_segment_index() {
  local tmp="$SEGMENT_DIR/.index.$$"
  (umask 077
    cat > "$tmp"
  )
  mv -f "$tmp" "$SEGMENT_INDEX"
}

discard_all_segments() {
  rm -f "$SEGMENT_INDEX"
  find "$SEGMENT_DIR" -mindepth 1 -maxdepth 1 ! -name index -delete 2>/dev/null || true
}

discard_old_segments() {
  local window="${1:-$CONFIG_SECONDS}"
  local now cutoff end path
  now=$(now_epoch)
  cutoff=$((now - window))
  [[ -r $SEGMENT_INDEX ]] || return 0
  local kept=""
  while IFS='|' read -r end path || [[ -n ${end:-} ]]; do
    [[ -n ${end:-} ]] || continue
    if (( end < cutoff )); then
      rm -f "$path"
      continue
    fi
    kept+="${end}|${path}"$'\n'
  done < "$SEGMENT_INDEX"
  if [[ -n $kept ]]; then
    printf '%s' "$kept" | write_segment_index
  else
    rm -f "$SEGMENT_INDEX"
  fi
}

flush_segment() {
  buffer_running || return 0
  local src dest end
  src=$(save_replay_path)
  [[ -e $src ]] || die "save-replay did not create a segment file"
  mkdir -p "$SEGMENT_DIR"
  chmod 700 "$SEGMENT_DIR"
  end=$(now_epoch)
  dest=$(mktemp "$SEGMENT_DIR/seg-${end}-XXXXXX")
  mv -f "$src" "$dest" || { cp -f "$src" "$dest" && rm -f "$src"; }
  printf '%s|%s\n' "$end" "$dest" >> "$SEGMENT_INDEX"
  discard_old_segments
}

join_canvas() {
  local max_w=1920 max_h=1080 name size w h
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    size=${line#*|}
    w=${size%%x*}
    h=${size#*x}
    [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || continue
    if (( w > max_w )); then max_w=$w; fi
    if (( h > max_h )); then max_h=$h; fi
  done < <(list_monitor_lines)
  printf '%sx%s\n' "$max_w" "$max_h"
}

live_capture_differs() {
  local monitor="$1"
  local live_monitor live_seconds live_audio
  live_monitor=$(activity_value monitor)
  live_seconds=$(activity_value seconds)
  live_audio=$(activity_value audio)
  [[ $live_monitor != "$monitor" ]] && return 0
  [[ $live_seconds != "$CONFIG_SECONDS" ]] && return 0
  [[ $live_audio != "$CONFIG_AUDIO" ]] && return 0
  return 1
}

stop_recorder() {
  local pid=""
  pid=$(read_pid 2>/dev/null || true)
  if [[ -z $pid ]] && ! cli_running; then
    rm -f "$PID_FILE"
    return 0
  fi

  if cli_running; then
    "$GSR_CLI_BIN" -ipc "$IPC" stop >/dev/null 2>&1 || true
  fi
  if [[ -n $pid ]] && pid_alive "$pid"; then
    kill -INT "$pid" 2>/dev/null || true
  fi
  if ! wait_until_stopped "$pid"; then
    if [[ -n $pid ]] && pid_alive "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PID_FILE" "$IPC"
}

launch_recorder() {
  command -v "$GSR_BIN" >/dev/null 2>&1 || die "gpu-screen-recorder is not installed"
  command -v "$GSR_CLI_BIN" >/dev/null 2>&1 || die "gsr-cli is not installed"

  if capture_device_busy; then
    die_device_busy
  fi

  local monitor seconds audio
  monitor=$(resolve_monitor)
  seconds=$CONFIG_SECONDS
  audio=$CONFIG_AUDIO
  mkdir -p "$GSR_OUTPUT_DIR"
  chmod 700 "$GSR_OUTPUT_DIR"

  local -a gsr_args=(
    -w "$monitor"
    -f "$CONFIG_FPS"
    -fm "$CONFIG_FRAMERATE_MODE"
    -k "$CONFIG_CODEC"
    -bm "$CONFIG_BITRATE_MODE"
    -q "$CONFIG_QUALITY"
    -r "$seconds"
    -replay-storage ram
    -fallback-cpu-encoding yes
    -ipc "$IPC"
    -o "$GSR_OUTPUT_DIR"
  )
  if [[ $CONFIG_CURSOR == false ]]; then
    gsr_args+=(-cursor no)
  fi
  case "$audio" in
  desktop) gsr_args+=(-a default_output -ac aac) ;;
  both) gsr_args+=(-a "default_output|default_input" -ac aac) ;;
  none) ;;
  *) die "invalid audio setting: $audio" ;;
  esac

  rm -f "$IPC"
  mkdir -p "$STATE_DIR"
  : > "$LOG_FILE"
  bash -c 'exec -a omarchy-shadowplay-gsr "$0" "$@"' "$GSR_BIN" "${gsr_args[@]}" >>"$LOG_FILE" 2>&1 &
  local pid=$!
  echo "$pid" > "$PID_FILE"

  if ! wait_until_running "$pid"; then
    local log
    log=$(tail -n 20 "$LOG_FILE" 2>/dev/null || true)
    if [[ -n $pid ]] && pid_alive "$pid"; then
      kill -INT "$pid" 2>/dev/null || true
      wait_until_stopped "$pid" || true
    fi
    rm -f "$PID_FILE"
    if capture_device_busy || log_looks_busy "$log"; then
      die_device_busy "$log"
    fi
    if [[ -n $log ]]; then
      die "replay buffer failed to start"$'\n'"$log"
    fi
    die "replay buffer failed to start"
  fi

  write_activity true "$monitor" "$seconds" "$audio" "$(activity_value last_clip)"
  notify "Replay buffer running" "$monitor · last ${seconds}s"
}

split_and_restart() {
  flush_segment
  stop_recorder
  launch_recorder
}

join_clip() {
  local live="$1"
  local out="$2"
  local -a inputs=()
  local end path i canvas canvas_w canvas_h fc maps
  if [[ -r $SEGMENT_INDEX ]]; then
    while IFS='|' read -r end path || [[ -n ${end:-} ]]; do
      [[ -n ${path:-} && -e $path ]] || continue
      inputs+=("$path")
    done < "$SEGMENT_INDEX"
  fi
  inputs+=("$live")
  if (( ${#inputs[@]} <= 1 )); then
    mv -f "$live" "$out" || { cp -f "$live" "$out" && rm -f "$live"; }
    printf '%s\n' "$out"
    return
  fi
  command -v "$FFMPEG_BIN" >/dev/null 2>&1 || die "ffmpeg is not installed"
  canvas=$(join_canvas)
  canvas_w=${canvas%%x*}
  canvas_h=${canvas#*x}
  local keep_audio=0
  [[ $CONFIG_AUDIO != none ]] && keep_audio=1
  fc=""
  maps=""
  for i in "${!inputs[@]}"; do
    fc+="[$i:v]scale=${canvas_w}:${canvas_h}:force_original_aspect_ratio=decrease,pad=${canvas_w}:${canvas_h}:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=60,format=yuv420p[v$i];"
    maps+="[v$i]"
    if (( keep_audio )); then
      fc+="[$i:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS[a$i];"
      maps+="[a$i]"
    fi
  done
  local -a ff_args=(-hide_banner -loglevel error -y)
  for path in "${inputs[@]}"; do
    ff_args+=(-i "$path")
  done
  if (( keep_audio )); then
    fc+="${maps}concat=n=${#inputs[@]}:v=1:a=1[v][a]"
    ff_args+=(-filter_complex "$fc" -map "[v]" -map "[a]" -c:v libx264 -preset veryfast -crf 18 -c:a aac -b:a 192k "$out")
  else
    fc+="${maps}concat=n=${#inputs[@]}:v=1:a=0[v]"
    ff_args+=(-filter_complex "$fc" -map "[v]" -an -c:v libx264 -preset veryfast -crf 18 "$out")
  fi
  "$FFMPEG_BIN" "${ff_args[@]}" || die "failed to join replay segments"
  rm -f "$live"
  printf '%s\n' "$out"
}

cmd_start() {
  load_config
  apply_start_flags "$@"
  write_config
  local monitor
  monitor=$(resolve_monitor)
  if buffer_running; then
    if live_capture_differs "$monitor"; then
      split_and_restart
    fi
    cmd_status
    return 0
  fi
  launch_recorder
  cmd_status
}

cmd_stop() {
  stop_recorder
  discard_all_segments
  write_activity false "$(activity_value monitor)" "$(activity_value seconds)" "$(activity_value audio)" "$(activity_value last_clip)"
}

cmd_save() {
  load_config
  buffer_running || die "replay buffer is not running"
  local seconds="${1:-}"
  if [[ -n $seconds ]]; then
    [[ $seconds =~ ^[0-9]+$ ]] || die "seconds must be a positive integer"
    (( seconds > 0 )) || die "seconds must be a positive integer"
  fi
  discard_old_segments "${seconds:-$CONFIG_SECONDS}"
  local live path dir stamp
  live=$(save_replay_path "$seconds")
  dir=$(output_dir)
  mkdir -p "$dir"
  stamp=$(now_epoch)
  path=$(join_clip "$live" "$dir/Replay-${stamp}.mp4")
  rm -f "$live"
  write_activity true "$(activity_value monitor)" "$(activity_value seconds)" "$(activity_value audio)" "$path"
  notify "Replay saved" "$path"
  printf '%s\n' "$path"
}

print_status_json() {
  local running="$1"
  printf '{'
  printf '"running":%s,' "$(json_bool "$running")"
  printf '"monitor":%s,' "$(json_string_or_null "${2:-}")"
  printf '"configuredMonitor":%s,' "$(json_string "$CONFIG_MONITOR")"
  printf '"seconds":%s,' "${3:-$CONFIG_SECONDS}"
  printf '"audio":%s,' "$(json_string "${4:-$CONFIG_AUDIO}")"
  printf '"pid":%s,' "$(json_string_or_null "${5:-}")"
  printf '"ipc":%s,' "$(json_string "$IPC")"
  printf '"outputDir":%s,' "$(json_string "$(output_dir)")"
  printf '"lastClip":%s,' "$(json_string_or_null "${6:-}")"
  print_settings_fields
  printf '}\n'
}

cmd_status() {
  load_config
  local json="false" pid="" running="false"
  if [[ ${1:-} == --json ]]; then
    json="true"
  fi
  pid=$(read_pid 2>/dev/null || true)
  if buffer_running; then
    running="true"
  else
    pid=""
  fi
  local monitor seconds audio last_clip
  monitor=$(activity_value monitor)
  seconds=$(activity_value seconds)
  audio=$(activity_value audio)
  last_clip=$(activity_value last_clip)
  [[ -n $seconds ]] || seconds=$CONFIG_SECONDS
  [[ -n $audio ]] || audio=$CONFIG_AUDIO
  if [[ $running == true && -z $monitor ]]; then
    monitor=$(resolve_monitor)
  fi

  if [[ $json == true ]]; then
    print_status_json "$running" "$monitor" "$seconds" "$audio" "$pid" "$last_clip"
    return
  fi
  if [[ $running == true ]]; then
    printf 'running %s last %ss audio=%s\n' "$monitor" "$seconds" "$audio"
  else
    printf 'stopped monitor=%s last %ss audio=%s\n' "${CONFIG_MONITOR:-focused}" "$CONFIG_SECONDS" "$CONFIG_AUDIO"
  fi
}

cmd_monitors() {
  local json="false"
  if [[ ${1:-} == --json ]]; then
    json="true"
  fi
  local focused
  focused=$(focused_monitor || true)
  if [[ $json == true ]]; then
    local first="true" line name size
    printf '['
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      name=${line%%|*}
      size=${line#*|}
      [[ $first == true ]] || printf ','
      first="false"
      printf '{"name":%s,"size":%s,"focused":%s}' \
        "$(json_string "$name")" \
        "$(json_string "$size")" \
        "$(json_bool "$([[ $name == "$focused" ]] && echo true || echo false)")"
    done < <(list_monitor_lines)
    printf ']\n'
    return
  fi
  local line name size mark
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    name=${line%%|*}
    size=${line#*|}
    mark=" "
    [[ $name == "$focused" ]] && mark="*"
    printf '%s %s %s\n' "$mark" "$name" "$size"
  done < <(list_monitor_lines)
}

cmd_settings_show() {
  load_config
  if [[ ${1:-} == --json ]]; then
    printf '{'
    printf '"monitor":%s,' "$(json_string "$CONFIG_MONITOR")"
    printf '"seconds":%s,' "$CONFIG_SECONDS"
    printf '"audio":%s,' "$(json_string "$CONFIG_AUDIO")"
    print_settings_fields
    printf '}\n'
    return
  fi
  printf 'monitor=%s\n' "$CONFIG_MONITOR"
  printf 'seconds=%s\n' "$CONFIG_SECONDS"
  printf 'audio=%s\n' "$CONFIG_AUDIO"
  printf 'mode=%s\n' "$CONFIG_MODE"
  printf 'filter=%s\n' "$CONFIG_FILTER"
  printf 'captureExtent=%s\n' "$CONFIG_CAPTURE_EXTENT"
}

cmd_settings_set() {
  load_config
  local key="${1:-}" value="${2:-}"
  [[ -n $key ]] || die_usage "settings set requires a key"
  case "$key" in
  monitor)
    CONFIG_MONITOR="$value"
    ;;
  seconds)
    [[ $value =~ ^[0-9]+$ ]] || die "seconds must be an integer"
    CONFIG_SECONDS="$value"
    clamp_seconds
    [[ $CONFIG_SECONDS == "$value" ]] || die "seconds must be between $MIN_SECONDS and $MAX_SECONDS"
    ;;
  audio)
    [[ $value == none || $value == desktop || $value == both ]] || die "audio must be none, desktop, or both"
    CONFIG_AUDIO="$value"
    ;;
  mode)
    [[ $value == monitor || $value == follow || $value == pin || $value == region ]] || die "mode must be monitor, follow, pin, or region"
    CONFIG_MODE="$value"
    ;;
  filter)
    [[ $value == all || $value == allowlist || $value == denylist ]] || die "filter must be all, allowlist, or denylist"
    CONFIG_FILTER="$value"
    ;;
  captureExtent)
    [[ $value == monitor || $value == window ]] || die "captureExtent must be monitor or window"
    CONFIG_CAPTURE_EXTENT="$value"
    ;;
  codec)
    [[ -n $value ]] || die "codec must not be empty"
    config_value_safe "$value" || die "codec value contains a newline"
    CONFIG_CODEC="$value"
    ;;
  fps)
    [[ $value =~ ^[0-9]+$ ]] || die "fps must be an integer"
    CONFIG_FPS="$value"
    clamp_fps
    [[ $CONFIG_FPS == "$value" ]] || die "fps must be between $MIN_FPS and $MAX_FPS"
    ;;
  quality)
    [[ $value =~ ^[0-9]+$ ]] || die "quality must be an integer"
    CONFIG_QUALITY="$value"
    ;;
  cursor)
    [[ $value == true || $value == false ]] || die "cursor must be true or false"
    CONFIG_CURSOR="$value"
    ;;
  framerateMode)
    [[ $value == cfr || $value == vfr ]] || die "framerateMode must be cfr or vfr"
    CONFIG_FRAMERATE_MODE="$value"
    ;;
  bitrateMode)
    [[ $value == cbr || $value == vbr ]] || die "bitrateMode must be cbr or vbr"
    CONFIG_BITRATE_MODE="$value"
    ;;
  *)
    die "unknown setting: $key"
    ;;
  esac
  write_config
  if buffer_running; then
    local monitor
    monitor=$(resolve_monitor)
    if live_capture_differs "$monitor"; then
      split_and_restart
    fi
  fi
  cmd_settings_show --json
}

cmd_doctor() {
  local ok="true"
  printf 'gpu-screen-recorder: '
  if command -v "$GSR_BIN" >/dev/null 2>&1; then
    printf 'ok (%s)\n' "$("$GSR_BIN" --version 2>/dev/null | head -n 1 || echo present)"
  else
    printf 'missing\n'
    ok="false"
  fi
  printf 'gsr-cli: '
  if command -v "$GSR_CLI_BIN" >/dev/null 2>&1; then
    printf 'ok\n'
  else
    printf 'missing\n'
    ok="false"
  fi
  printf 'monitors:\n'
  cmd_monitors
  printf 'ipc: %s\n' "$IPC"
  printf 'buffer: '
  if buffer_running; then
    printf 'running\n'
  else
    printf 'stopped\n'
  fi
  printf 'session recording: '
  if capture_device_busy; then
    printf 'running (capture device busy)\n'
  else
    printf 'not detected\n'
  fi
  [[ $ok == true ]]
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
  ""|-h|--help) usage ;;
  --version|-V) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
  start) shift; cmd_start "$@" ;;
  stop) cmd_stop ;;
  save) shift; cmd_save "${1:-}" ;;
  status) shift; cmd_status "${1:-}" ;;
  monitors) shift; cmd_monitors "${1:-}" ;;
  settings)
    shift
    case "${1:-}" in
    show) shift; cmd_settings_show "${1:-}" ;;
    set) shift; cmd_settings_set "${1:-}" "${2:-}" ;;
    *) die_usage "settings expects show or set" ;;
    esac
    ;;
  doctor) cmd_doctor ;;
  *) die_usage "unknown command: $cmd" ;;
  esac
}

main "$@"
