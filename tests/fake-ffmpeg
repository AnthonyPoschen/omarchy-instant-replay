#!/usr/bin/env bash
set -euo pipefail

FAKE_DIR="${SHADOWPLAY_FAKE_DIR:?SHADOWPLAY_FAKE_DIR is not set}"
mkdir -p "$FAKE_DIR"

printf '%s\n' "$@" > "$FAKE_DIR/ffmpeg.args"
if command -v nice >/dev/null 2>&1; then
  nice > "$FAKE_DIR/ffmpeg.nice" || true
fi

running=0
if [[ -r $FAKE_DIR/ffmpeg.running ]]; then
  running=$(<"$FAKE_DIR/ffmpeg.running")
fi
printf '%s\n' "$((running + 1))" > "$FAKE_DIR/ffmpeg.running"

cleanup_running() {
  local n=0
  [[ -r $FAKE_DIR/ffmpeg.running ]] && n=$(<"$FAKE_DIR/ffmpeg.running")
  if [[ $n =~ ^[0-9]+$ ]] && (( n > 0 )); then
    printf '%s\n' "$((n - 1))" > "$FAKE_DIR/ffmpeg.running"
  fi
}
trap cleanup_running EXIT

if [[ -n ${SHADOWPLAY_FFMPEG_HOLD:-} ]]; then
  while [[ -e $SHADOWPLAY_FFMPEG_HOLD ]]; do
    sleep 0.05
  done
fi

: > "$FAKE_DIR/concat.list"
out=""
prev=""
for arg in "$@"; do
  if [[ $prev == -i ]]; then
    printf '%s\n' "$arg" >> "$FAKE_DIR/concat.list"
  fi
  prev="$arg"
  out="$arg"
done

[[ -n $out ]] || exit 1
: > "$out"
printf '%s\n' "$out" > "$FAKE_DIR/concat.out"
